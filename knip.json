{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "examples/**"
  ],
  "ignoreBinaries": [
    "safe-chain"
  ],
  "ignoreExportsUsedInFile": true,
  "exclude": [
    "exports",
    "types",
    "optionalPeerDependencies",
    "duplicates"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.{mjs,ts}",
        "stryker*.config.mjs"
      ],
      "ignoreDependencies": [
        "ws",
        "@stryker-mutator/api"
      ]
    },
    "packages/aai": {
      "entry": [
        "host/_test-utils.ts",
        "host/integration/**/*.integration.test.ts",
        "**/*.test.ts",
        "**/*.test-d.ts"
      ],
      "includeEntryExports": true
    },
    "packages/aai-ui": {
      "entry": [
        "**/*.test.{ts,tsx}",
        "_react-test-utils.ts"
      ],
      "includeEntryExports": true
    },
    "packages/aai-cli": {
      "entry": [
        "**/*.test.ts",
        "_test-utils.ts"
      ]
    },
    "packages/aai-templates": {
      "ignore": [
        "templates/**",
        "scaffold/**"
      ],
      "ignoreDependencies": [
        "@alexkroman1/aai-ui"
      ]
    },
    "packages/aai-guest": {
      "entry": [
        "**/*.test.ts"
      ],
      "includeEntryExports": true,
      "ignoreDependencies": [
        "@alexkroman1/aai-ui",
        "@types/react",
        "@types/react-dom",
        "react",
        "react-dom",
        "tailwindcss"
      ]
    },
    "packages/aai-server": {
      "entry": [
        "**/*.test.ts"
      ],
      "includeEntryExports": true,
      "ignoreDependencies": [
        "@types/json-schema"
      ],
      "ignoreBinaries": [
        "modal"
      ]
    },
    "packages/aai-studio-client": {
      "entry": [
        "**/*.test.{ts,tsx}"
      ],
      "includeEntryExports": true
    },
    "packages/aai-studio-server": {
      "entry": [
        "**/*.test.ts"
      ],
      "includeEntryExports": true,
      "ignoreDependencies": [
        "@alexkroman1/aai-ui",
        "react",
        "react-dom",
        "tailwindcss"
      ],
      "ignoreBinaries": [
        "modal"
      ]
    }
  }
}
