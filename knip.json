{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "examples/**"
  ],
  "ignoreBinaries": [
    "safe-chain"
  ],
  "ignoreExportsUsedInFile": true,
  // The "exports" check is ON. It was off repo-wide for a long time because
  // enabling it reported 174 unused exports — but that number came from
  // `includeEntryExports` on the three PUBLISHED packages, which made knip
  // report their entry files' exports (the aai-ui components, createRuntime,
  // the provider factories) as unused. Those are the API: their consumers are
  // templates and user projects knip cannot see, so reporting them is knip
  // being asked the wrong question, not a finding.
  //
  // So `includeEntryExports` is set only on the PRIVATE packages, where every
  // importer is inside this repo and knip therefore sees the whole picture.
  // The published packages keep the check for everything that is NOT reachable
  // from a subpath export — internal helpers that lost their last caller,
  // which is exactly what the check is for and what "exports": excluded was
  // hiding. First run of the split found 8, including a re-export of the
  // project-environment pair that its comment claimed callers were using.
  //
  // "types" stays excluded pending the @internal tagging pass.
  "exclude": [
    "types",
    "optionalPeerDependencies",
    "duplicates"
  ],
  "workspaces": {
    ".": {
      "entry": [
        // Recursive: standalone tools live in their own subdirectory when they
        // ship more than one file (scripts/starter-eval/), and each file there
        // is run directly rather than imported.
        "scripts/**/*.{mjs,ts}",
        "stryker*.config.mjs"
      ],
      "ignoreDependencies": [
        "@stryker-mutator/api"
      ]
    },
    "packages/aai": {
      "entry": [
        "host/_test-utils.ts",
        "host/integration/**/*.integration.test.ts",
        "**/*.test.ts",
        "**/*.test-d.ts"
      ]
    },
    "packages/aai-ui": {
      "entry": [
        "**/*.test.{ts,tsx}",
        "**/*.test-d.ts",
        "_react-test-utils.ts"
      ]
    },
    "packages/aai-cli": {
      "entry": [
        "**/*.test.ts",
        "_test-utils.ts"
      ],
      // `workflow` is a real devDependency that no source file imports: the
      // workflow-bundler fixture symlinks this package's node_modules into a
      // temp project so the Workflow DevKit resolves THERE. It has to be
      // installed here for that to work — esbuild resolves an external import
      // to decide it is a package at all, and the discovery pass reads the
      // module to check it for directives — but an import in our own source
      // would be a lie written to satisfy this gate.
      "ignoreDependencies": [
        "workflow"
      ]
    },
    "packages/aai-templates": {
      "ignore": [
        "templates/**",
        "scaffold/**"
      ],
      "ignoreDependencies": [
        "@alexkroman1/aai-ui"
      ]
    },
    "packages/aai-guest": {
      "entry": [
        "**/*.test.ts"
      ],
      "includeEntryExports": true,
      "ignoreDependencies": [
        "@alexkroman1/aai-ui",
        "@types/react",
        "@types/react-dom",
        "react",
        "react-dom",
        "tailwindcss"
      ]
    },
    "packages/aai-server": {
      "entry": [
        "**/*.test.ts"
      ],
      "includeEntryExports": true,
      "ignoreDependencies": [
        "@types/json-schema"
      ],
      "ignoreBinaries": [
        "modal"
      ]
    },
    "packages/aai-studio-client": {
      "entry": [
        "**/*.test.{ts,tsx}"
      ],
      "includeEntryExports": true
    },
    "packages/aai-studio-server": {
      "entry": [
        "**/*.test.ts"
      ],
      "includeEntryExports": true,
      "ignoreDependencies": [
        "@alexkroman1/aai-ui",
        "react",
        "react-dom",
        "tailwindcss"
      ]
    }
  }
}
