{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "examples/**"
  ],
  "ignoreBinaries": [
    "safe-chain"
  ],
  "ignoreExportsUsedInFile": true,
  // "exports" and "types" stay excluded for now: enabling them (with
  // `"tags": ["-internal"]` to skip @internal-tagged exports) reported
  // 174 unused exports, most of them the genuinely public SDK surface
  // (aai-ui components/hooks, createRuntime, provider factories) whose
  // only consumers are templates/user projects knip cannot see. Revisit
  // once the @internal tagging pass settles and the public barrels are
  // explicit lists — then enable both checks plus the tags filter.
  "exclude": [
    "exports",
    "types",
    "optionalPeerDependencies",
    "duplicates"
  ],
  "workspaces": {
    ".": {
      "entry": [
        // Recursive: standalone tools live in their own subdirectory when they
        // ship more than one file (scripts/voice-replay/), and each file there
        // is run directly rather than imported.
        "scripts/**/*.{mjs,ts}",
        "stryker*.config.mjs"
      ],
      "ignoreDependencies": [
        "ws",
        "@stryker-mutator/api"
      ]
    },
    "packages/aai": {
      "entry": [
        "host/_test-utils.ts",
        "host/integration/**/*.integration.test.ts",
        "**/*.test.ts",
        "**/*.test-d.ts"
      ],
      "includeEntryExports": true
    },
    "packages/aai-ui": {
      "entry": [
        "**/*.test.{ts,tsx}",
        "_react-test-utils.ts"
      ],
      "includeEntryExports": true
    },
    "packages/aai-cli": {
      "entry": [
        "**/*.test.ts",
        "_test-utils.ts"
      ]
    },
    "packages/aai-templates": {
      "ignore": [
        "templates/**",
        "scaffold/**"
      ],
      "ignoreDependencies": [
        "@alexkroman1/aai-ui"
      ]
    },
    "packages/aai-guest": {
      "entry": [
        "**/*.test.ts"
      ],
      "includeEntryExports": true,
      "ignoreDependencies": [
        "@alexkroman1/aai-ui",
        "@types/react",
        "@types/react-dom",
        "react",
        "react-dom",
        "tailwindcss"
      ]
    },
    "packages/aai-server": {
      "entry": [
        "**/*.test.ts"
      ],
      "includeEntryExports": true,
      "ignoreDependencies": [
        "@types/json-schema"
      ],
      "ignoreBinaries": [
        "modal"
      ]
    },
    "docs": {
      "ignoreDependencies": [
        "typedoc"
      ],
      "ignoreBinaries": [
        "typedoc"
      ]
    },
    "packages/aai-studio-client": {
      "entry": [
        "**/*.test.{ts,tsx}"
      ],
      "includeEntryExports": true
    },
    "packages/aai-studio-server": {
      "entry": [
        "**/*.test.ts"
      ],
      "includeEntryExports": true,
      "ignoreDependencies": [
        "@alexkroman1/aai-ui",
        "react",
        "react-dom",
        "tailwindcss"
      ],
      "ignoreBinaries": [
        "modal"
      ]
    }
  }
}
