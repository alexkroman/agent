{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "examples/**"
  ],
  "ignoreBinaries": [
    "safe-chain",
    // `with-test-pg.mjs` shells out to `supabase status -o env` to resolve the
    // local stack. It is a developer's own CLI (brew/npx), deliberately not a
    // dependency: this repo must not install a 100 MB binary to run its tests,
    // and the script treats an absent one as "no stack resolved" with a printed
    // reason rather than a failure.
    "supabase"
  ],
  "ignoreExportsUsedInFile": true,
  // The "exports" check is ON. It was off repo-wide for a long time because
  // enabling it reported 174 unused exports — but that number came from
  // `includeEntryExports` on the three PUBLISHED packages, which made knip
  // report their entry files' exports (the aai-ui components, createRuntime,
  // the provider factories) as unused. Those are the API: their consumers are
  // templates and user projects knip cannot see, so reporting them is knip
  // being asked the wrong question, not a finding.
  //
  // So `includeEntryExports` is set only on the PRIVATE packages, where every
  // importer is inside this repo and knip therefore sees the whole picture.
  // The published packages keep the check for everything that is NOT reachable
  // from a subpath export — internal helpers that lost their last caller,
  // which is exactly what the check is for and what "exports": excluded was
  // hiding. First run of the split found 8, including a re-export of the
  // project-environment pair that its comment claimed callers were using.
  //
  // "types" stays excluded pending the @internal tagging pass.
  "exclude": [
    "types",
    "optionalPeerDependencies",
    "duplicates"
  ],
  "workspaces": {
    ".": {
      // WHAT A PIPELINE INVOKES, and nothing else.
      //
      // This was `scripts/**/*.{mjs,ts}` — every file in `scripts/` declared an
      // entry point, which means the repo's one "what is unused" tool could
      // never report a dead script. It could not have: an entry point is
      // reachable by definition. Three dead chains were sitting in there
      // (`starter-eval/builtins.mjs` and `starter-eval/tsconfig-ab.mjs`, both
      // reading a `run.json` from a producer that was deleted, and
      // `scripts/aai-dev.sh`, duplicating `pnpm aai`), and they are the same
      // documented dead-config family as the `.size-limit.json` nothing read,
      // the `ls-lint` config no pipeline ran, and the `.turbo` path that never
      // matched `cacheDir`.
      //
      // The old comment justified the recursion with "standalone tools live in
      // their own subdirectory (scripts/starter-eval/), and each file there is
      // run directly rather than imported" — which was true of the two files
      // that turned out to be dead, and false of the survivor
      // (`expectations.mjs`, imported by `packages/aai-evals`).
      //
      // A script that is a MODULE (`_*.mjs`, `guard-invariants-rules.mjs`,
      // `artifact-size-format.mjs`) is deliberately absent: knip reaches it
      // through the entry that imports it, and losing its last importer is
      // precisely the finding this glob was suppressing. Add a name here only
      // when a pipeline runs it — that makes the exception a reviewable line.
      "entry": [
        "scripts/check.sh",
        "scripts/create-changeset.sh",
        // Everything a root `package.json` script or a vitest `globalSetup`
        // names is discovered by knip itself and must NOT be repeated here —
        // it reports a repeat as a redundant pattern, which is the same
        // reviewability property working in the other direction.
        //
        // `gen-gateway-models.mjs` is the one script a pipeline never runs:
        // `check:gateway-models` shells out to it, by path, at runtime. Manual
        // on purpose — see AGENTS.md, "Two manual diagnostics".
        "scripts/gen-gateway-models.mjs",
        "stryker*.config.mjs"
      ],
      "ignoreDependencies": [
        "@stryker-mutator/api"
      ]
    },
    "packages/aai": {
      "entry": [
        "host/_test-utils.ts",
        "**/*.test.ts",
        "**/*.test-d.ts",
        // The capability contracts. Nothing imports either directory and
        // nothing is meant to: a capability root exists so api-contracts.mjs
        // can extract a report for that slice of the authoring API, and a
        // compatibility fixture exists so `tsc` fails when a frozen authoring
        // example stops compiling. Both are "unused" in knip's sense and load
        // -bearing in the only sense that matters here.
        "contracts/entrypoints/*.ts",
        "contracts/compatibility/**/*.ts"
      ]
    },
    "packages/aai-runtime": {
      "entry": [
        // Test helpers and fuzz harnesses: imported only by sibling specs, and
        // the fixtures directory is read at runtime by the replay harness.
        "_test-utils.ts",
        "**/*-test-utils.ts",
        "integration/**/*.integration.test.ts",
        "**/*.test.ts"
      ]
    },
    "packages/aai-ui": {
      "entry": [
        "**/*.test.{ts,tsx}",
        "**/*.test-d.ts",
        "_react-test-utils.ts",
        // The capability contracts, same as `packages/aai` above: a root exists
        // so api-contracts.mjs can extract a report for that slice of the
        // authoring API, and a compatibility fixture exists so `tsc` fails when
        // a frozen authoring example stops compiling. The fixtures are `.tsx`
        // here — a component library's authoring example is JSX.
        "contracts/entrypoints/*.ts",
        "contracts/compatibility/**/*.{ts,tsx}"
      ]
    },
    "packages/aai-cli": {
      "entry": [
        "**/*.test.ts",
        "_test-utils.ts"
      ],
      // `workflow` needs no entry here any more: `dev-workflow.scenario.test.ts`
      // imports `workflow/api` for real, to start a run against the dev server it
      // just booted. It was ignored while the only use was a fixture project
      // symlinking this package's node_modules so the DevKit resolved THERE.
    },
    // `templates/**` stays ignored so a template's unused EXPORTS never reach
    // the report — they are examples, not a surface anything imports. The
    // `@alexkroman1/aai-ui` entry that used to sit beside it is gone:
    // `template-page-mount.test.ts` globs every `client.tsx` as text to
    // correlate its mount with its agent's `page` field, so knip now sees the
    // import that was always there and the exemption became a lie.
    "packages/aai-templates": {
      "ignore": [
        "templates/**",
        "scaffold/**"
      ],
      // `scaffold/**` is ignored above, and `scaffold/server.mjs` is the only
      // thing that imports the runtime — but the dependency is real: the
      // scaffold is shipped to users by `aai init`, and
      // `check:template-types` compiles that file from inside this package,
      // so it has to resolve here. Unused by knip's reading, load-bearing by
      // the gate's.
      "ignoreDependencies": [
        "@alexkroman1/aai-runtime"
      ]
    },
    "packages/aai-guest": {
      "entry": [
        "**/*.test.ts"
      ],
      "includeEntryExports": true,
      // The two workflow packages are RESOLVED, not imported. The serving code
      // lives in `@alexkroman1/aai` (the CLI needs the identical wiring for
      // `aai dev`, and may not import the guest), and tsdown bundles it in — but
      // `rewriteWorkflowImports` calls `import.meta.resolve("workflow")` at
      // runtime, from wherever `dist/harness.mjs` sits, to point a tenant's step
      // bundle at a real copy. On the subprocess backend that walk-up lands in
      // THIS package's node_modules, so the declaration is what puts one there.
      // A string inside a bundled dependency is not something knip can see.
      //
      // The rest are declared so a STUDIO WORKSPACE can resolve them, not
      // because this package imports them: they are the third-party half of
      // `WORKSPACE_DEPENDENCIES`, and declaring them here is what lets
      // `sync-guest-toolchain.mjs` read the version this checkout installed —
      // which is the only thing keeping the baked toolchain and the toolchain
      // the repo builds and tests with from drifting.
      "ignoreDependencies": [
        "@alexkroman1/aai-ui",
        "@types/react",
        "@types/react-dom",
        "@workflow/world-postgres",
        "react",
        "react-dom",
        "tailwindcss",
        "workflow",
        "xstate"
      ]
    },
    "packages/aai-server": {
      "entry": [
        "**/*.test.ts"
      ],
      "includeEntryExports": true,
      "ignoreDependencies": [
        "@types/json-schema"
      ],
      "ignoreBinaries": [
        "modal"
      ]
    },
    "packages/aai-evals": {
      "entry": [
        "**/*.test.ts",
        "**/*.eval.test.ts"
      ],
      "includeEntryExports": true
    },
    "packages/aai-studio-client": {
      "entry": [
        "**/*.test.{ts,tsx}"
      ],
      "includeEntryExports": true
    },
    "docs": {
      // knip's typedoc plugin discovers `typedoc.json` by name and nothing
      // else, so the SECOND config — the markdown one `pnpm docs:md` renders
      // through — was invisible, and the plugin it loads read as an unused
      // dependency. Naming both is what keeps that honest in the direction
      // that matters: drop `typedoc-plugin-markdown` from the config and knip
      // reports the dependency, rather than the config silently rendering
      // without it.
      "typedoc": {
        "config": [
          "typedoc.json",
          "typedoc.markdown.json"
        ]
      }
    },
    "packages/aai-studio-server": {
      "entry": [
        "**/*.test.ts"
      ],
      "includeEntryExports": true,
      "ignoreDependencies": [
        "@alexkroman1/aai-ui",
        "react",
        "react-dom",
        "tailwindcss"
      ]
    }
  }
}
