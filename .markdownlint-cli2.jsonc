{
  "ignores": [
    ".changeset/**",
    "**/CHANGELOG.md",
    "plans/**",
    "docs/superpowers/**",
    ".worktrees/**",
    ".remember/**",
    // Build output, never source. The CLI's build copies the templates into
    // its dist/ to ship them, which drags their prompt markdown along.
    "**/dist/**",
    // API Extractor's reports (`pnpm api-report`). Markdown by file extension
    // only — the content is a generated `.d.ts` rollup in a fenced block, and
    // the file leads with an `##` heading followed by a "Do not edit this file"
    // line. Linting a generated artifact for prose style means either editing
    // it (which the next run reverts) or turning off the rule for real docs.
    "**/etc/*.api.md",
    // The same reports concatenated into one file (`pnpm api-report`), for a
    // reader that wants the whole published surface in a single pass. Generated
    // for the same reason and ignored on the same grounds: prose findings in it
    // can only be fixed by editing a file the next run overwrites.
    "API.md",
    // The reverse index over the same reports (`pnpm api-report`): every
    // published name against the subpath to import it from. Generated, so a
    // prose finding in it can only be fixed by editing a file the next run
    // overwrites — the same grounds as the two above.
    "API-INDEX.md",
    // TypeDoc's markdown output (`pnpm docs:md`) — the committed API
    // reference an agent reads instead of the published site. Generated on
    // the same grounds as the two above: a prose finding in it can only be
    // fixed by editing a file the next run overwrites, and the style is the
    // plugin's, not ours.
    "docs/api/**",
    // Generated by `pnpm sync:agent-guide` from
    // packages/aai-templates/scaffold/CLAUDE.md, which IS linted. Linting the
    // copy would report every finding twice and, worse, invite someone to fix
    // it in the generated file — which the next sync reverts.
    "packages/aai/AGENT_GUIDE.md",
    // The root guide is AGENTS.md; this file is the single line `@AGENTS.md`
    // that makes Claude Code resolve it. It is an import directive, not a
    // document, so "first line should be a top-level heading" cannot be
    // satisfied without turning it into a second copy of the guide — which is
    // the exact failure `check:claude-md` pins it against.
    "CLAUDE.md",
    "packages/aai-templates/templates/**/system-prompt.md"
  ]
}
