{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:unit": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run check:integration",
    "test:pg": "node scripts/with-test-pg.mjs pnpm test:integration",
    "test:e2e": "turbo run check:e2e --concurrency=1",
    "test:aai-core": "pnpm --filter @alexkroman1/aai test",
    "test:aai-ui": "pnpm --filter @alexkroman1/aai-ui test",
    "test:aai-cli": "pnpm --filter @alexkroman1/aai-cli test",
    "test:aai-server": "pnpm --filter aai-server test",
    "test:aai-studio-client": "pnpm --filter aai-studio-client test",
    "test:templates": "pnpm --filter aai-templates test",
    "test:mutate": "stryker run",
    "test:mutate:sdk": "stryker run stryker.sdk.config.mjs",
    "test:mutate:host": "stryker run stryker.host.config.mjs",
    "test:mutate:server": "stryker run stryker.server.config.mjs",
    "test:mutate:cli": "stryker run stryker.cli.config.mjs",
    "test:mutate:ui": "stryker run stryker.ui.config.mjs",
    "test:mutate:studio": "stryker run stryker.studio.config.mjs",
    "aai": "node packages/aai-cli/cli.ts",
    "dev:aai-server": "pnpm --filter aai-studio-server dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "biome check --write .",
    "check": "bash scripts/check.sh",
    "docs:api": "pnpm --filter aai-docs docs",
    "check:local": "bash scripts/check.sh --local",
    "check:affected": "turbo run build typecheck lint test:coverage --affected --continue",
    "test:coverage:affected": "turbo run test:coverage --affected --continue",
    "check:hatches": "node scripts/check-escape-hatches.mjs",
    "check:invariants": "node scripts/guard-invariants.mjs",
    "artifact-size": "node scripts/artifact-size-report.mjs",
    "check:file-length": "node scripts/check-file-length.mjs",
    "check:test-assertions": "node scripts/check-test-assertions.mjs",
    "check:claude-md": "node scripts/check-claude-md.mjs",
    "check:konsistent": "konsistent check",
    "check:konsistent-config": "konsistent validate",
    "check:gateway-models": "node scripts/check-gateway-models.mjs",
    "check:guest-toolchain": "node scripts/sync-guest-toolchain.mjs --check",
    "sync:agent-guide": "node scripts/sync-agent-guide.mjs",
    "check:agent-guide": "node scripts/sync-agent-guide.mjs --check",
    "check:knip": "knip",
    "check:publint": "turbo run check:publint",
    "api-report": "node scripts/api-report.mjs",
    "check:api-report": "node scripts/api-report.mjs --check",
    "api-contracts": "node scripts/api-contracts.mjs",
    "check:api-contracts": "node scripts/api-contracts.mjs",
    "check:publish-names": "node scripts/check-publish-names.mjs",
    "check:publish-protocols": "node scripts/check-publish-protocols.mjs",
    "check:template-types": "node scripts/check-template-types.mjs",
    "check:doc-examples": "node scripts/check-doc-examples.mjs",
    "check:sherif": "sherif --ignore-package aai-docs",
    "check:syncpack": "syncpack lint",
    "check:markdown": "markdownlint-cli2 '**/*.md' '#**/node_modules' '#.aai' '#.claude' '#.superpowers'",
    "syncpack": "syncpack",
    "changeset": "changeset",
    "changeset:create": "bash scripts/create-changeset.sh",
    "version": "changeset version && node scripts/sync-scaffold-versions.mjs",
    "sync:guest-toolchain": "node scripts/sync-guest-toolchain.mjs",
    "release": "turbo run build && changeset publish",
    "prepare": "[ \"$(git rev-parse --git-dir 2>/dev/null)\" != \"$(git rev-parse --git-common-dir 2>/dev/null)\" ] || lefthook install --force",
    "test:aai-studio-server": "pnpm --filter aai-studio-server test",
    "lint:scripts": "biome check scripts/"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.5",
    "@changesets/cli": "^2.31.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^4.1.10",
    "eventsource-parser": "catalog:",
    "knip": "^6.29.0",
    "konsistent": "1.0.0-beta.4",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.1",
    "publint": "^0.3.22",
    "react": "catalog:",
    "sherif": "1.13.0",
    "syncpack": "^15.3.2",
    "turbo": "^2.10.6",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=26 <27"
  }
}
