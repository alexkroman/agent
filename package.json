{
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "aai": "node packages/aai-cli/cli.ts",
    "api-nameable:update": "node scripts/check-api-nameable.mjs --update",
    "api-report": "node scripts/api-report.mjs",
    "artifact-size": "node scripts/artifact-size-report.mjs",
    "audit:gateway-models": "node scripts/check-gateway-models.mjs",
    "bench:uploads": "node scripts/upload-sweep.mjs",
    "build": "turbo run build",
    "build:guest-image": "node scripts/build-guest-image.mjs",
    "bundled-deps:update": "node scripts/check-bundled-deps.mjs --update",
    "changeset": "changeset",
    "changeset:create": "bash scripts/create-changeset.sh",
    "check": "node scripts/check.mjs",
    "check:affected": "node scripts/with-worker-budget.mjs turbo run build typecheck lint test:coverage --affected --continue",
    "check:agent-guide": "node scripts/sync-agent-guide.mjs --check",
    "check:api-contracts": "node scripts/api-contracts.mjs",
    "check:api-nameable": "node scripts/check-api-nameable.mjs",
    "check:api-report": "node scripts/api-report.mjs --check",
    "check:authoring-guide": "node scripts/check-authoring-guide.mjs",
    "check:bundled-deps": "node scripts/check-bundled-deps.mjs",
    "check:claude-md": "node scripts/check-claude-md.mjs",
    "check:coverage-per-file": "node scripts/check-coverage-per-file.mjs",
    "check:dedupe": "pnpm dedupe --check",
    "check:defaults": "node scripts/check-defaults.mjs",
    "check:deploy-changeset": "node scripts/check-deploy-changeset.mjs",
    "check:doc-examples": "node scripts/check-doc-examples.mjs",
    "check:docs-md": "node scripts/docs-markdown.mjs --check",
    "check:duplication": "node scripts/check-duplication.mjs",
    "check:file-length": "node scripts/check-file-length.mjs",
    "check:format": "syncpack format --check",
    "check:gate-catalogue": "node scripts/check.mjs --catalogue check",
    "check:guest-contract": "node scripts/check-guest-contract.mjs",
    "check:guest-toolchain": "node scripts/sync-guest-toolchain.mjs --check",
    "check:guide-index": "node scripts/docs-list.mjs --check",
    "check:hatches": "node scripts/check-escape-hatches.mjs",
    "check:invariants": "node scripts/guard-invariants.mjs",
    "check:knip": "knip",
    "check:konsistent": "konsistent check",
    "check:local": "node scripts/check.mjs --local",
    "check:markdown": "markdownlint-cli2 '**/*.{md,mdx}' '#**/node_modules' '#.aai' '#.claude' '#.superpowers'",
    "check:migration-order": "node scripts/check-migration-order.mjs",
    "check:module-tests": "node scripts/check-module-tests.mjs",
    "check:optional-peers": "node scripts/check-optional-peers.mjs",
    "check:package-layout": "node scripts/check-package-layout.mjs",
    "check:polyglot": "node scripts/check-polyglot.mjs",
    "check:prettier": "prettier --check '**/*.{md,mdx,yml,yaml,sh}' '**/*.Dockerfile' '.{changeset,claude,github}/**/*.{md,yml,yaml,sh}' '.*.{yml,yaml}'",
    "check:property-floors": "node scripts/check-property-floors.mjs",
    "check:provider-table": "node scripts/sync-provider-table.mjs --check",
    "check:publint": "turbo run check:publint",
    "check:publish-names": "node scripts/check-publish-names.mjs",
    "check:publish-protocols": "node scripts/check-publish-protocols.mjs",
    "check:scaffold": "node scripts/sync-scaffold-versions.mjs --check",
    "check:shell": "node scripts/check-shell.mjs",
    "check:sherif": "sherif --ignore-package aai-docs --fail-on-warnings",
    "check:studio-prompt": "node scripts/sync-studio-prompt.mjs --check",
    "check:syncpack": "syncpack lint",
    "check:template-types": "node scripts/check-template-types.mjs",
    "check:test-assertions": "node scripts/check-test-assertions.mjs",
    "check:untyped-imports": "node scripts/check-untyped-imports.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "claude-md:update": "node scripts/check-claude-md.mjs --update",
    "debt:report": "node scripts/debt-report.mjs",
    "dev:aai-server": "pnpm --filter aai-studio-server dev",
    "docs:api": "pnpm --filter aai-docs docs",
    "docs:list": "node scripts/docs-list.mjs",
    "docs:md": "node scripts/docs-markdown.mjs",
    "duplication:update": "node scripts/check-duplication.mjs --update",
    "file-length:update": "node scripts/check-file-length.mjs --update",
    "fix": "node scripts/check.mjs --fix",
    "format": "pnpm run lint:fix && pnpm run format:prettier && pnpm run format:polyglot",
    "format:polyglot": "node scripts/check-polyglot.mjs --fix",
    "format:prettier": "prettier --write '**/*.{md,mdx,yml,yaml,sh}' '**/*.Dockerfile' '.{changeset,claude,github}/**/*.{md,yml,yaml,sh}' '.*.{yml,yaml}'",
    "gen:gateway-models": "node scripts/gen-gateway-models.mjs --write",
    "hatches:update": "node scripts/check-escape-hatches.mjs --update",
    "invariants:update": "node scripts/guard-invariants.mjs --update",
    "lint": "turbo run lint lint:root lint:promises",
    "lint:fix": "biome check --write .",
    "lint:promises": "oxlint --type-aware --deny-warnings --format unix .",
    "lint:root": "biome check --error-on-warnings scripts/ examples/ *.ts *.mjs *.json .markdownlint-cli2.jsonc .syncpackrc.json .oxlintrc.json .prettierrc.json .changeset/config.json .claude/settings.json",
    "loadtest": "node scripts/loadtest-cli.mjs",
    "module-tests:update": "node scripts/check-module-tests.mjs --update",
    "prepare": "[ \"$(git rev-parse --git-dir 2>/dev/null)\" != \"$(git rev-parse --git-common-dir 2>/dev/null)\" ] || lefthook install --force",
    "property-floors:update": "node scripts/check-property-floors.mjs --update",
    "release": "turbo run build && changeset publish",
    "sync:agent-guide": "node scripts/sync-agent-guide.mjs",
    "sync:gate-catalogue": "node scripts/check.mjs --catalogue write",
    "sync:guest-toolchain": "node scripts/sync-guest-toolchain.mjs",
    "sync:guide-index": "node scripts/docs-list.mjs --write",
    "sync:provider-table": "node scripts/sync-provider-table.mjs",
    "sync:scaffold": "node scripts/sync-scaffold-versions.mjs",
    "sync:studio-prompt": "node scripts/sync-studio-prompt.mjs",
    "syncpack": "syncpack",
    "test": "node scripts/with-worker-budget.mjs turbo run test",
    "test:aai-cli": "pnpm --filter @alexkroman1/aai-cli test",
    "test:aai-core": "pnpm --filter @alexkroman1/aai test",
    "test:aai-evals": "pnpm --filter aai-evals test",
    "test:aai-server": "pnpm --filter aai-server test",
    "test:aai-studio-client": "pnpm --filter aai-studio-client test",
    "test:aai-studio-server": "pnpm --filter aai-studio-server test",
    "test:aai-ui": "pnpm --filter @alexkroman1/aai-ui test",
    "test:coverage": "node scripts/with-worker-budget.mjs turbo run test:coverage",
    "test:coverage:affected": "node scripts/with-worker-budget.mjs turbo run test:coverage --affected --continue",
    "test:e2e": "turbo run check:e2e --concurrency=1",
    "test:eval": "node scripts/run-evals.mjs",
    "test:eval:templates": "node scripts/run-evals.mjs --filter aai-templates",
    "test:integration": "node scripts/with-worker-budget.mjs turbo run check:integration",
    "test:mutate:sdk": "stryker run stryker.sdk.config.mjs",
    "test:pg": "node scripts/with-test-pg.mjs pnpm test:scenario",
    "test:scenario": "node scripts/with-worker-budget.mjs turbo run check:scenario",
    "test:templates": "pnpm --filter aai-templates test",
    "typecheck": "turbo run typecheck",
    "typecheck:browser": "tsc -p tsconfig.browser.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "version": "changeset version && node scripts/sync-scaffold-versions.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@microsoft/api-extractor": "7.59.1",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@taplo/cli": "^0.7.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^5.0.1",
    "jscpd": "^4.3.0",
    "knip": "^6.38.0",
    "konsistent": "1.0.0-beta.11",
    "lefthook": "^2.1.14",
    "markdownlint-cli2": "^0.23.3",
    "oxc-parser": "^0.148.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "prettier-plugin-sh": "^0.20.2",
    "publint": "^0.3.24",
    "react": "catalog:",
    "sherif": "1.13.0",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.3",
    "typescript": "catalog:",
    "typescript-6": "catalog:typedoc",
    "vitest": "catalog:",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@10.29.3"
}
