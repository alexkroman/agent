node_modules/
dist/
.aai/
# Scratch dirs where the studio materializes a workspace for its client build
.studio-build/
# Local workflow world state (`aai dev` with no DATABASE_URL) and @swc/core's
# plugin cache, both written into whatever project the workflow builder runs in
.workflow-data/
.swc/
# Playwright MCP scratch output (screenshots, console logs)
.playwright-mcp/
# Local agent-tooling state, not project content
.superpowers/
.remember/
.env
.env.*
!.env.example
.DS_Store
tmp/
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/plans/
.tsbuildinfo/
coverage/
reports/
.stryker-tmp/
.stryker-incremental*.json
# Dropped in the repo root by @stryker-mutator/vitest-runner on every run.
stryker-setup-*.js
.worktrees/
.turbo/
__pycache__/
*.pyc
temp/
tmp/
!tmp/.gitkeep
docs/superpowers/
packages/*/package.json.e2e-backup

# Guest session scratch (aai-guest writes workspaces next to the harness)
.workspaces/

# check-doc-examples scratch (cleaned up on exit; ignore crash leftovers)
.doc-examples-scratch-*/
tsconfig.doc-examples-*.json

# Supabase CLI link state (`supabase link` writes the project ref and the
# remote's component versions here). Deliberately NOT the whole `supabase/`
# directory: config.toml and migrations/ are checked in and load-bearing —
# the platform schema is applied from there before every deploy.
supabase/.temp/
# Local-stack scratch state, written by `supabase start` (the Tier 1 rig for
# realtime-rls.integration.test.ts). Not link state and not checked in: a
# developer who has never run the local stack should see a clean tree.
supabase/.branches/

# Scratch for the capability-contract extractor (removed on exit)
.api-contracts-cache/

# Scenario-test fixture (`dev-workflow.scenario.test.ts`): written inside the
# package because both bundlers resolve `workflow` by walking up from the
# project, and removed in the test's `afterAll`. Present only mid-run.
packages/aai-cli/.dev-workflow-fixture/

# This checkout's packed SDK, staged into the guest image's build context by
# `scripts/build-guest-image.mjs` for a LOCAL build. Build output, not source —
# but the DIRECTORY is committed (`.gitkeep`), because the Dockerfile's COPY of
# it is unconditional and a missing path fails the build.
packages/aai-guest/sdk-tarballs/*.tgz
# Where a template-contract run materializes a workspace
# (`studio-template-contract.ts`). It is a `src/` path because that is where the
# module's own `new URL("./.eval-workspaces/", import.meta.url)` resolves to —
# this entry named `packages/aai-evals/.eval-workspaces/`, one level up from the
# directory anything ever wrote, so it matched nothing for as long as it existed.
packages/aai-studio-server/src/.eval-workspaces/

# Agent scratch: reproductions and probes, never committed.
zz-*
.zz-*
# `starlight-typedoc` renders the generated SDK reference into the content
# collection at build time, so this is build output that happens to live under
# `src/`. Ignoring it also keeps it out of `assertEveryDocsPageListed`
# (`scripts/_docs-site-pages.mjs`), which lists the site's pages from
# `git ls-files --exclude-standard`.
docs/src/content/docs/reference/
docs/.astro/
