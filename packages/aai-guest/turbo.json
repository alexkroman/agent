{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // `build` (own, not just `^build`): `harness/externals.test.ts` asserts on
    // `dist/harness.mjs` — that a `neverBundle` package is really external in the
    // ARTIFACT, which a config assertion cannot show. A test that skipped itself
    // when the harness was absent would be the silent-skip failure this repo
    // keeps paying for: the one check standing between a shipped guest and a
    // workflow world that cannot start, quietly not running. Declaring the build
    // is the rule the root guide states for exactly this.
    //
    // The scaffold drift gate moved to `aai-guest-studio` with
    // `project-shape.test.ts`, and its inputs went with it — an input glob
    // belongs to whichever package READS the file.
    //
    // A task named here REPLACES the root's definition rather than merging with
    // it, so `env` and `outputs` are restated verbatim — dropping either is
    // silent.
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "../../vitest.shared.ts"],
      "env": ["CI", "VITEST_POOL"]
    },
    "test:coverage": {
      "dependsOn": ["^build", "build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "../../vitest.shared.ts"],
      "outputs": ["coverage/**"],
      "env": ["CI", "VITEST_POOL"]
    }
  }
}
