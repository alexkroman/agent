{
  "name": "aai-guest",
  "version": "0.6.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./package.json": "./package.json",
    "./harness": "./dist/harness.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "biome check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alexkroman1/aai": "workspace:*",
    "@alexkroman1/aai-cli": "workspace:*",
    "@alexkroman1/aai-runtime": "workspace:*",
    "@alexkroman1/aai-ui": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "aai-guest-core": "workspace:*",
    "aai-guest-studio": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "ws": "catalog:",
    "xstate": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
