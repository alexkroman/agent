{
  "name": "aai-guest",
  "version": "0.4.26",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./harness": "./dist/harness.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:scenario": "VITEST_PROFILE=scenario VITEST_INCLUDE=**/*.scenario.test.ts vitest run -c ../../vitest.slow.config.ts",
    "check:scenario": "pnpm run test:scenario",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@alexkroman1/aai": "workspace:*",
    "@alexkroman1/aai-cli": "workspace:*",
    "@alexkroman1/aai-ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@workflow/world-postgres": "4.3.3",
    "ai": "catalog:",
    "diff": "^9.0.0",
    "p-timeout": "catalog:",
    "picomatch": "^4.0.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "workflow": "4.8.2",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/picomatch": "^4.0.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
