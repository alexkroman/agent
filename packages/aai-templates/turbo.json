{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // Two of this package's suites read files OUTSIDE it, and an `inputs` glob
    // resolves relative to the PACKAGE — so without these entries the suites
    // are served from cache exactly when the thing they check changes.
    // `templates.test.ts` reads `../../biome.json` (the `tools/` filename
    // override every template's tools rely on) and the scaffold guide;
    // `template-api-coverage.test.ts` reads
    // `scripts/_api-contracts-tree.mjs`.
    //
    // The long list this file used to carry — `AGENTS.md`, every package
    // guide, `API.md`, `API-EXPORTS.json`, every `etc/*.api.md`, every
    // `contracts/` tree, `konsistent.json`, `lefthook.yml`, every workflow —
    // moved to `packages/aai-gates/turbo.json` with the 28 repo-gate suites
    // that read them. A package reaching four levels out to hash the repo root
    // was the build config saying those tests did not belong here.
    //
    // Markdown is re-included (the root task drops it) because
    // `scaffold/CLAUDE.md` IS an input here — it ships to users and
    // `templates.test.ts` asserts on its content.
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../vitest.shared.ts",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/scripts/**"
      ],
      "env": ["CI", "VITEST_POOL"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../vitest.shared.ts",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/scripts/**"
      ],
      "outputs": ["coverage/**"],
      "env": ["CI", "VITEST_POOL"]
    }
  }
}
