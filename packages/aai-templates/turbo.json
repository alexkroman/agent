{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // This package's suites are the only ones that read files OUTSIDE their own
    // package, and none of those files were hashed — so the gates that guard
    // the gates were served from cache exactly when the thing they check
    // changed. `claude-md-limit.test.ts` globs `../../AGENTS.md`,
    // `../../CLAUDE.md` and `../*/CLAUDE.md` (the 120k cap, the assertion that
    // the root still links every package guide, and the pin on the root shim); `test-assertion-gate.test.ts` and
    // `escape-hatch-scope.test.ts` spec `scripts/check-*.mjs` and assert the
    // script, `scripts/check.sh`, root `package.json` and the CI check job
    // still agree with each other; `konsistent-config.test.ts` reads
    // `konsistent.json` the same way; `api-surface-file.test.ts` reads
    // `../../API.md` and every `../*/etc/*.api.md`; `api-contracts-gate.test.ts`
    // reads `../../API-EXPORTS.json` and the whole of
    // `../aai/contracts/` (the capability roots, the epoch metadata, and the
    // frozen compatibility examples). Touching any of them left
    // `aai-templates#test` at an identical hash.
    //
    // Markdown is re-included (the root task drops it) because a CLAUDE.md IS
    // the input here, not documentation about it.
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../vitest.shared.ts",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/CLAUDE.md",
        "$TURBO_ROOT$/packages/*/CLAUDE.md",
        "$TURBO_ROOT$/API.md",
        "$TURBO_ROOT$/API-EXPORTS.json",
        "$TURBO_ROOT$/packages/*/etc/*.api.md",
        "$TURBO_ROOT$/packages/aai/contracts/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/konsistent.json",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/.github/workflows/check.yml"
      ],
      "env": ["CI", "VITEST_POOL"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../vitest.shared.ts",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/CLAUDE.md",
        "$TURBO_ROOT$/packages/*/CLAUDE.md",
        "$TURBO_ROOT$/API.md",
        "$TURBO_ROOT$/API-EXPORTS.json",
        "$TURBO_ROOT$/packages/*/etc/*.api.md",
        "$TURBO_ROOT$/packages/aai/contracts/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/konsistent.json",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/.github/workflows/check.yml"
      ],
      "outputs": ["coverage/**"],
      "env": ["CI", "VITEST_POOL"]
    }
  }
}
