{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "@alexkroman1/aai": ["../aai/src/index.ts"],
      "@alexkroman1/aai-ui": ["../aai-ui/src/index.ts"]
    }
  },
  "include": [
    "scaffold/global.d.ts",
    // Deliberately generic: tsc's `include` only sets *root* files, and a
    // test file is imported by nothing, so anything not listed here is
    // never typechecked at all (unlike source modules, which get pulled in
    // transitively via imports from an included root). Globbing every
    // template file/test means a new template's source or test file is
    // covered on creation, not on the next config edit.
    //
    // The package's own files were named ONE BY ONE despite that, and the
    // list had fallen three behind: `escape-hatch-scope.test.ts`,
    // `template-api-coverage.test.ts` and `test-assertion-gate.test.ts` were
    // type-checked by nothing (verified with `tsc --listFiles`, and by
    // injecting `const x: number = "s"` into one and watching `tsc --noEmit`
    // report zero errors). `src` is the same argument as the template globs
    // below — the next file added here is covered on creation. It matches
    // only this directory, so `scaffold/` stays out: that tree is checked
    // separately by `check:template-types`, under the SCAFFOLD's looser
    // tsconfig, which is the point of checking it there.
    "src",
    "*.ts",
    "templates/*/*.ts",
    "templates/*/*.tsx",
    "templates/*/tools/*.ts"
  ],
  "exclude": [
    // `coding-agent/chat.ts` is the one template file this program cannot
    // hold, and it is NOT unchecked: `check:template-types` compiles it under
    // the SCAFFOLD's tsconfig, which is the config a user actually gets, and
    // konsistent's `template-authoring-boundary` still reads its imports.
    //
    // What it names is `@alexkroman1/aai-runtime`'s ROOT barrel — the only way
    // to reach `createTextAgent` and `withToolsDir` — and `@dev/source`
    // resolves that to SOURCE, so including it pulls that package's whole
    // module graph into this program. That graph does not compile under the
    // `lib` above: `_upload-blobs-*.ts` and `step-fetch.ts` pass a
    // `Uint8Array` as a `BodyInit`, which undici's types admit and the DOM
    // lib's do not. It is the same hazard `packages/aai-runtime/CLAUDE.md`
    // records against handing SDK internals on through
    // `@alexkroman1/aai-runtime/internal`, arriving by the front door: the
    // template evals stay clean only because `/eval` and `/eval/vitest` reach
    // a narrower graph.
    "templates/coding-agent/chat.ts"
  ]
}
