# dependencies
node_modules/

# build output (managed by CLI)
.aai/

# prebuilt deployment emitted by `aai build --target` — generated, never
# authored, and rewritten by the host's own build, so committing it would pin
# a stale copy. The `deno` target needs no entry here: it emits into `.aai/`,
# which is already ignored above.
.vercel/

# local workflow runs and uploads (written by `aai dev`)
.workflow-data/

# env files
.env
.env.*
!.env.example

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# typescript
*.tsbuildinfo
