{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "incremental": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    // The capability contracts are typechecked by `tsc --noEmit` (the `typecheck`
    // task), never emitted: they are a repo artifact, and `rootDir: "."` would
    // otherwise put 18 stray `.d.ts` files under `dist/contracts/`. For aai-ui
    // that is not merely dead output — its `files: ["dist"]` would SHIP them.
    "src/contracts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/_test-utils.ts",
    "**/*-test-utils.ts",
    "**/_react-test-utils.ts",
    "vitest*.config.ts"
  ]
}
