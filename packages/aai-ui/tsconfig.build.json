{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "incremental": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    // The one compiler-level statement that this package runs in a BROWSER.
    // `tsconfig.json` sets `types: ["node", "vitest/globals"]` for the suites,
    // so without this line a shipped module could reference `process.env`,
    // `Buffer` or `__dirname`, typecheck clean, and fail at runtime in the only
    // environment this package has. konsistent's dependency-graph rules cannot
    // see it: they check SPECIFIERS, and a global is not an import.
    //
    // `aai` has had this all along one directory down — `src/sdk/tsconfig.json`
    // sets `types: []`, which is what makes its `sdk/` vs `host/` boundary real
    // rather than a naming convention. This is the same thing for the whole
    // package, and it is set at ZERO: the emit program compiles clean with it
    // today, so it is a ratchet recorded at its floor rather than a cleanup.
    "types": []
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    // The capability contracts are typechecked by `tsc --noEmit` (the `typecheck`
    // task), never emitted: they are a repo artifact, and `rootDir: "."` would
    // otherwise put 18 stray `.d.ts` files under `dist/contracts/`. For aai-ui
    // that is not merely dead output — its `files: ["dist"]` would SHIP them.
    "src/contracts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/_test-utils.ts",
    "**/*-test-utils.ts",
    "**/_react-test-utils.ts",
    "vitest*.config.ts"
  ]
}
