{
  "name": "@alexkroman1/aai-ui",
  "version": "6.11.0",
  "type": "module",
  "files": [
    "dist",
    "styles.css"
  ],
  "exports": {
    ".": {
      "@dev/source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client-dir": {
      "@dev/source": "./client-dir.ts",
      "types": "./dist/client-dir.d.ts",
      "import": "./dist/client-dir.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json",
    "./default-client/*": "./dist/default-client/*"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown && tsc -p tsconfig.build.json && node build-default-client.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check:publint": "publint",
    "check:attw": "attw --pack --profile esm-only --entrypoints ."
  },
  "dependencies": {
    "@alexkroman1/aai": "workspace:*",
    "clsx": "catalog:",
    "partysocket": "^1.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "use-stick-to-bottom": "catalog:",
    "use-sync-external-store": "^1.6.0",
    "xstate": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/use-sync-external-store": "^1.5.0",
    "@vitejs/plugin-react": "catalog:",
    "fast-check": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexkroman/agent.git",
    "directory": "packages/aai-ui"
  }
}
