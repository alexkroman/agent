{
  "name": "@alexkroman1/aai-ui",
  "version": "5.9.0",
  "type": "module",
  "files": [
    "dist",
    "styles.css"
  ],
  "exports": {
    ".": {
      "@dev/source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client-dir": {
      "@dev/source": "./client-dir.ts",
      "types": "./dist/client-dir.d.ts",
      "import": "./dist/client-dir.js"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json",
    "./default-client/*": "./dist/default-client/*"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown && tsc -p tsconfig.build.json && node build-default-client.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check:publint": "publint",
    "check:attw": "attw --pack --profile esm-only --entrypoints ."
  },
  "dependencies": {
    "@alexkroman1/aai": "workspace:*",
    "clsx": "^2.1.1",
    "partysocket": "^1.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "use-stick-to-bottom": "^1.1.6",
    "use-sync-external-store": "^1.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/use-sync-external-store": "^1.5.0",
    "@vitejs/plugin-react": "^6.0.4",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.13",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexkroman/agent.git",
    "directory": "packages/aai-ui"
  }
}
