{
  "name": "aai-evals",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./env": {
      "@dev/source": "./src/env.ts"
    },
    "./gate": {
      "@dev/source": "./src/gate.ts"
    },
    "./register": {
      "@dev/source": "./src/register.ts"
    },
    "./report": {
      "@dev/source": "./src/report.ts"
    },
    "./runner": {
      "@dev/source": "./src/runner.ts"
    }
  },
  "scripts": {
    "check:eval": "pnpm run test:eval",
    "lint": "biome check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:eval": "VITEST_PROFILE=eval VITEST_INCLUDE=**/*.eval.test.ts vitest run -c ../../vitest.slow.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alexkroman1/aai": "workspace:*",
    "@alexkroman1/aai-runtime": "workspace:*",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
