{
  "name": "@alexkroman1/aai-runtime",
  "version": "12.0.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexkroman/agent.git",
    "directory": "packages/aai-runtime"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "@dev/source": "./runtime-barrel.ts",
      "types": "./dist/runtime-barrel.d.ts",
      "import": "./dist/runtime-barrel.js"
    },
    "./eval": {
      "@dev/source": "./eval-barrel.ts",
      "types": "./dist/eval-barrel.d.ts",
      "import": "./dist/eval-barrel.js"
    },
    "./eval/vitest": {
      "@dev/source": "./eval-vitest-barrel.ts",
      "types": "./dist/eval-vitest-barrel.d.ts",
      "import": "./dist/eval-vitest-barrel.js"
    },
    "./testing": {
      "@dev/source": "./testing-barrel.ts",
      "types": "./dist/testing-barrel.d.ts",
      "import": "./dist/testing-barrel.js"
    },
    "./internal": {
      "@dev/source": "./internal.ts",
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "check:attw": "attw --pack --profile esm-only",
    "check:integration": "pnpm run test:integration",
    "check:publint": "publint",
    "check:scenario": "pnpm run test:scenario",
    "lint": "biome check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "VITEST_INCLUDE=integration/**/*.integration.test.ts vitest run -c ../../vitest.slow.config.ts",
    "test:scenario": "VITEST_PROFILE=scenario VITEST_INCLUDE=**/*.scenario.test.ts vitest run -c ../../vitest.slow.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/groq": "^4.0.28",
    "@ai-sdk/mistral": "^4.0.29",
    "@ai-sdk/openai": "^4.0.40",
    "@ai-sdk/xai": "^4.0.38",
    "@alexkroman1/aai": "workspace:*",
    "@cartesia/cartesia-js": "^4.1.0",
    "@deepgram/sdk": "^5.8.0",
    "@elevenlabs/elevenlabs-js": "^2.63.0",
    "ai": "catalog:",
    "assemblyai": "^4.36.7",
    "escape-html": "^1.0.3",
    "jsonrepair": "^3.15.0",
    "mime-types": "catalog:",
    "nanoevents": "catalog:",
    "p-event": "^7.1.0",
    "p-timeout": "catalog:",
    "postgres": "^3.4.9",
    "ulid": "catalog:",
    "undici": "^8.10.0",
    "ws": "catalog:",
    "xstate": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/escape-html": "^1.0.4",
    "@types/json-schema": "catalog:",
    "@types/mime-types": "catalog:",
    "@types/ws": "catalog:",
    "fast-check": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
