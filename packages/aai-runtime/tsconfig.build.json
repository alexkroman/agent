{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "incremental": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "dist",
    // The capability contracts are typechecked by `tsc --noEmit` (the
    // `typecheck` task) and never emitted: they are a repo artifact, and
    // `rootDir: "."` otherwise writes a `.d.ts` per capability root and per
    // frozen example into `dist/contracts/`. This package declares
    // `files: ["dist"]`, so unlike `aai` — whose bare `contracts/` ignore rule
    // catches it at any depth — that output would really have shipped.
    "src/contracts",
    "**/*.test.ts",
    "**/*.test-d.ts",
    "**/_test-utils.ts",
    "**/*-test-utils.ts",
    // Test SCAFFOLDING that is neither a `*.test.ts` nor named `*-test-utils`:
    // the store-contract case lists and the per-subject harnesses. They shipped
    // as `.d.ts` in the tarball for as long as the glob named only the two
    // patterns above — `_runtime-conformance`, `_session-core-harness`,
    // `_workflow-engine-harness`, `_workflow-resume-harness` and, behind that
    // last one, `_test-utils` itself, which the exclude above could not remove
    // because an EXCLUDED file is still pulled into the program by any INCLUDED
    // importer. Verified by building and listing `dist`, not by reading the
    // glob. Two files deliberately survive it: `journal-conformance*.ts` is
    // reached from `internal.ts`'s `loadJournalConformance`, i.e. it is shipped
    // code now, and `_fake-llm.ts` is imported by `eval/stub-llm.ts`, which is
    // the `/eval` subpath's own.
    "**/*-conformance.ts",
    "**/*-harness.ts",
    "**/fixtures",
    "**/integration",
    "vitest*.config.ts"
  ]
}
