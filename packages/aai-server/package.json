{
  "name": "aai-server",
  "version": "5.3.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./stores": "./src/stores-barrel.ts",
    "./sandbox": "./src/sandbox-barrel.ts",
    "./platform": "./src/platform-barrel.ts",
    "./http": "./src/http-barrel.ts",
    "./config": "./src/config-barrel.ts",
    "./logger": "./src/logger-barrel.ts",
    "./test-utils": "./src/test-utils-barrel.ts"
  },
  "scripts": {
    "check:scenario": "pnpm run test:scenario",
    "deploy:modal": "modal deploy modal_deploy.py",
    "lint": "biome check .",
    "predeploy:modal": "node ../../scripts/ensure-guest-harness.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:scenario": "VITEST_PROFILE=scenario VITEST_INCLUDE=**/*.scenario.test.ts vitest run -c ../../vitest.slow.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alexkroman1/aai": "workspace:*",
    "@alexkroman1/aai-runtime": "workspace:*",
    "@alexkroman1/aai-ui": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@hono/otel": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-trace-otlp-proto": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@supabase/auth-js": "^2.114.0",
    "@supabase/realtime-js": "^2.114.0",
    "@supabase/storage-js": "^2.114.0",
    "aai-guest": "workspace:*",
    "hono": "catalog:",
    "human-id": "^4.2.1",
    "is-network-error": "^1.3.2",
    "json-rpc-2.0": "^1.8.0",
    "lru-cache": "^11.5.2",
    "mime-types": "catalog:",
    "modal": "^0.10.0",
    "p-retry": "^8.0.1",
    "p-timeout": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/mime-types": "catalog:",
    "@types/ws": "catalog:",
    "fast-check": "catalog:",
    "microsandbox": "0.6.16",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
