{
  "name": "aai-server",
  "version": "1.3.5",
  "private": true,
  "type": "module",
  "main": "dist/index.mjs",
  "scripts": {
    "predev": "node -e \"const [maj] = process.versions.node.split('.').map(Number); if (maj < 24) { console.error('Node >=24 required (got ' + process.version + '). Run: fnm use 24'); process.exit(1); }\"",
    "dev": "node --conditions=@dev/source index.ts",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test:integration": "VITEST_INCLUDE=orchestrator-integration.test.ts,ws-integration.test.ts,fake-vm-integration*.test.ts,gvisor-integration*.test.ts vitest run -c ../../vitest.slow.config.ts",
    "check:integration": "pnpm run test:integration",
    "test:docker": "VITEST_PROFILE=docker VITEST_INCLUDE=docker-build.test.ts vitest run -c ../../vitest.slow.config.ts",
    "test:gvisor": "VITEST_PROFILE=gvisor VITEST_INCLUDE=packages/aai-server/gvisor-integration*.test.ts vitest run -c ../../vitest.slow.config.ts",
    "test:evals": "VITEST_PROFILE=e2e VITEST_INCLUDE=studio/studio-eval.test.ts vitest run -c ../../vitest.slow.config.ts",
    "push-dashboards": "node --conditions=@dev/source grafana/push-dashboards.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.18",
    "@alexkroman1/aai": "workspace:*",
    "@alexkroman1/aai-cli": "workspace:*",
    "@alexkroman1/aai-ui": "workspace:*",
    "@hono/node-server": "^2.0.11",
    "@hono/prometheus": "^1.0.3",
    "@hono/zod-validator": "^0.9.0",
    "@node-rs/argon2": "^2.0.2",
    "@sindresorhus/slugify": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "aai-studio-client": "workspace:*",
    "ai": "^7.0.41",
    "aws4fetch": "^1.0.20",
    "diff": "^9.0.0",
    "hono": "^4.12.31",
    "human-id": "^4.2.0",
    "iron-webcrypto": "^2.0.0",
    "is-network-error": "^1.3.2",
    "json-rpc-2.0": "^1.7.1",
    "mime-types": "^3.0.2",
    "nanoid": "^6.0.0",
    "p-retry": "^8.0.0",
    "picomatch": "^4.0.5",
    "prom-client": "^15.1.3",
    "quick-lru": "^7.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.2",
    "unstorage": "^1.17.5",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/mime-types": "^3.0.1",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "tsdown": "^0.22.13",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vitest-evals": "^0.15.0"
  },
  "engines": {
    "node": ">=24"
  }
}
