{
  "name": "aai-server",
  "version": "3.6.5",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test:scenario": "VITEST_PROFILE=scenario VITEST_INCLUDE=**/*.scenario.test.ts vitest run -c ../../vitest.slow.config.ts",
    "check:scenario": "pnpm run test:scenario",
    "dev:management-api": "node --conditions=@dev/source dev-management-api.ts",
    "predeploy:modal": "node ../../scripts/ensure-guest-harness.mjs",
    "deploy:modal": "modal deploy modal_deploy.py"
  },
  "dependencies": {
    "@alexkroman1/aai": "workspace:*",
    "@alexkroman1/aai-runtime": "workspace:*",
    "@alexkroman1/aai-ui": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "catalog:",
    "@supabase/auth-js": "^2.112.3",
    "@supabase/realtime-js": "^2.112.3",
    "@supabase/storage-js": "^2.112.3",
    "aai-guest": "workspace:*",
    "hono": "catalog:",
    "human-id": "^4.2.0",
    "is-network-error": "^1.3.2",
    "json-rpc-2.0": "^1.7.1",
    "lru-cache": "^11.5.2",
    "mime-types": "catalog:",
    "modal": "^0.9.0",
    "p-retry": "^8.0.0",
    "p-timeout": "catalog:",
    "quick-lru": "^7.3.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "supabase-management-js": "^2.0.2",
    "tailwindcss": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/json-schema": "catalog:",
    "@types/mime-types": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "exports": {
    "./app-database": "./app-database.ts",
    "./app-db-browse": "./app-db-browse.ts",
    "./chat-store": "./chat-store.ts",
    "./secret-store": "./secret-store.ts",
    "./secret-handler": "./secret-handler.ts",
    "./secrets": "./secrets.ts",
    "./store-types": "./store-types.ts",
    "./workspace-store": "./workspace-store.ts",
    "./platform-events": "./platform-events.ts",
    "./platform-lock": "./platform-lock.ts",
    "./sandbox-backend": "./sandbox-backend.ts",
    "./sandbox-directory": "./sandbox-directory.ts",
    "./sandbox-vm": "./sandbox-vm.ts",
    "./teardown-sandboxes": "./teardown-sandboxes.ts",
    "./rpc-schemas": "./rpc-schemas.ts",
    "./schemas": "./schemas.ts",
    "./slug-generate": "./slug-generate.ts",
    "./api-key-verify": "./api-key-verify.ts",
    "./app-middleware": "./app-middleware.ts",
    "./client-ip": "./client-ip.ts",
    "./context": "./context.ts",
    "./rate-limit": "./rate-limit.ts",
    "./live-streams": "./live-streams.ts",
    "./middleware": "./middleware.ts",
    "./public-origin": "./public-origin.ts",
    "./serve-lifecycle": "./serve-lifecycle.ts",
    "./service-config": "./service-config.ts",
    "./studio-paths": "./studio-paths.ts",
    "./constants": "./constants.ts",
