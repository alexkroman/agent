    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/json-schema": "catalog:",
    "@types/mime-types": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "catalog:",
    "fast-check": "catalog:",
    "microsandbox": "0.6.16",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
