{
  "name": "aai-server",
  "version": "5.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    "./chat-store": "./src/chat-store.ts",
    "./secret-store": "./src/secret-store.ts",
    "./secret-handler": "./src/secret-handler.ts",
    "./secrets": "./src/secrets.ts",
    "./store-types": "./src/store-types.ts",
    "./workspace-store": "./src/workspace-store.ts",
    "./platform-events": "./src/platform-events.ts",
    "./platform-lock": "./src/platform-lock.ts",
    "./sandbox-backend": "./src/sandbox-backend.ts",
    "./sandbox-directory": "./src/sandbox-directory.ts",
    "./sandbox-vm": "./src/sandbox-vm.ts",
    "./teardown-sandboxes": "./src/teardown-sandboxes.ts",
    "./rpc-schemas": "./src/rpc-schemas.ts",
    "./schemas": "./src/schemas.ts",
    "./slug-generate": "./src/slug-generate.ts",
    "./api-key-verify": "./src/api-key-verify.ts",
    "./app-middleware": "./src/app-middleware.ts",
    "./client-ip": "./src/client-ip.ts",
    "./context": "./src/context.ts",
    "./rate-limit": "./src/rate-limit.ts",
    "./live-streams": "./src/live-streams.ts",
    "./middleware": "./src/middleware.ts",
    "./logger": "./src/logger.ts",
    "./public-origin": "./src/public-origin.ts",
    "./serve-lifecycle": "./src/serve-lifecycle.ts",
    "./service-config": "./src/service-config.ts",
    "./studio-paths": "./src/studio-paths.ts",
    "./constants": "./src/constants.ts",
    "./delete": "./src/delete.ts",
    "./guest-routes": "./src/guest-routes.ts",
    "./orchestrator": "./src/orchestrator.ts",
    "./supabase-auth": "./src/supabase-auth.ts",
    "./platform-barrel": "./src/platform-barrel.ts",
    "./test-utils": "./src/test-utils.ts",
    "./platform-schema-test-utils": "./src/platform-schema-test-utils.ts"
  },
  "scripts": {
    "check:scenario": "pnpm run test:scenario",
    "deploy:modal": "modal deploy modal_deploy.py",
    "lint": "biome check .",
    "predeploy:modal": "node ../../scripts/ensure-guest-harness.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:scenario": "VITEST_PROFILE=scenario VITEST_INCLUDE=**/*.scenario.test.ts vitest run -c ../../vitest.slow.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alexkroman1/aai": "workspace:*",
    "@alexkroman1/aai-runtime": "workspace:*",
    "@alexkroman1/aai-ui": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@hono/otel": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-trace-otlp-proto": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@supabase/auth-js": "^2.114.0",
    "@supabase/realtime-js": "^2.114.0",
    "@supabase/storage-js": "^2.114.0",
    "aai-guest": "workspace:*",
    "hono": "catalog:",
    "human-id": "^4.2.1",
    "is-network-error": "^1.3.2",
    "json-rpc-2.0": "^1.8.0",
    "lru-cache": "^11.5.2",
    "mime-types": "catalog:",
    "modal": "^0.10.0",
    "p-retry": "^8.0.1",
    "p-timeout": "catalog:",
