# AAI Platform Server — copy to .env and fill in values
PORT=8080

# Required in production
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=aai-agents
# Optional: Supabase project region for the S3 endpoint (default us-east-1)
SUPABASE_S3_REGION=us-east-1
# Service-role Postgres connection string (Vault secrets + per-app databases)
SUPABASE_DB_URL=
