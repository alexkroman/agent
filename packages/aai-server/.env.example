# AAI Platform Server — copy to .env and fill in values
PORT=8080

# Required
BUCKET_NAME=aai-agents
KV_SCOPE_SECRET=change-me-to-a-random-secret

# Tigris S3 (bundle storage)
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Upstash Redis (platform-default KV) — optional. When set, ctx.kv and the
# remember/recall builtins run on Redis instead of the S3 bucket. Both vars
# required; falls back to the bucket when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
