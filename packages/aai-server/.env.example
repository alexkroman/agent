# AAI Platform Server — copy to .env and fill in values
PORT=8080

# Required in production
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_STORAGE_BUCKET=aai-agents
# Optional: Supabase project region for the S3 endpoint (default us-east-1)
SUPABASE_S3_REGION=us-east-1
# Service-role Postgres connection string (Vault secrets + per-app databases).
# Must be the project's own `postgres` role: the per-app database is created by
# the Management API as `postgres`, and its grants require ownership.
SUPABASE_DB_URL=

# Supabase personal access token (sbp_...) from
# https://supabase.com/dashboard/account/tokens. REQUIRED alongside
# SUPABASE_DB_URL outside local dev: `create database` / `drop database` for
# per-app databases are Supabase Management API calls and have no SQL fallback.
SUPABASE_ACCESS_TOKEN=
# Optional: the project ref those calls target. Derived from SUPABASE_DB_URL
# (`db.<ref>.supabase.co`, or the pooler username suffix `postgres.<ref>`) when
# unset; set it when the URL cannot carry it. Primary cluster only — APP_DB_URLS
# entries always derive their own.
SUPABASE_PROJECT_REF=

# Supabase project URL + service-role key — Realtime change streams
# (sandbox invalidation, studio preview push). Required in production.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Supabase publishable key (sb_publishable_...) — studio browser login via
# Supabase Auth. Missing means browser login is disabled (boot warning);
# raw API-key bearers still work.
SUPABASE_PUBLISHABLE_KEY=

# Modal credentials for guest sandboxes (required outside local dev; a ~/.modal.toml profile also works)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
