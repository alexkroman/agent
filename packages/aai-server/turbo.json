{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // Only `dependsOn`: turbo merges per FIELD across `extends`, so inputs,
    // env and outputs come from the root task. `^build` is what this suite
    // needs and the root no longer gives (a package-level `dependsOn` REPLACES
    // the inherited one): it reads two built artifacts off disk via
    // `require.resolve` — aai-ui's `dist/default-client` and `aai-guest/harness`
    // (which `createSandbox` resolves eagerly). Declared, so `aai-guest#build`
    // can never run concurrently with the tests; the `ensure-guest-harness.mjs`
    // globalSetup only builds a MISSING harness outside turbo.
    "test": { "dependsOn": ["^build"] },
    "test:coverage": { "dependsOn": ["^build"] }
  }
}
