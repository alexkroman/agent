{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      // `^build` — every workspace dependency's build, which is exactly what
      // the ROOT test task declares. This override used to narrow it to
      // `["@alexkroman1/aai-ui#build"]`, and turbo's package-level `dependsOn`
      // REPLACES the inherited value rather than merging it, so aai-server
      // became the one package whose tests were not ordered after its
      // dependencies' builds. The aai-ui entry was redundant anyway — aai-ui is
      // a `workspace:*` dependency, so `^build` already covers it.
      //
      // This suite reads TWO built artifacts off disk, both via
      // `require.resolve`: aai-ui's `dist/default-client` (transport-websocket.ts
      // — the default UI served to agents with no client.tsx) and
      // `aai-guest/harness` (constants.ts `resolveHarnessPath`, which
      // createSandbox resolves eagerly). Only the first was declared, so
      // `aai-guest#build` could run CONCURRENTLY with the tests: tsdown rewrites
      // `dist/` mid-run and every sandbox test fails with "Guest harness not
      // built". The `ensure-guest-harness.mjs` globalSetup cannot cover that —
      // it builds a MISSING harness, and has no way to wait out one being
      // rebuilt underneath it.
      "dependsOn": ["^build"],
      "inputs": ["**/*.ts", "**/*.tsx", "vitest.config.ts", "../../vitest.shared.ts"],
      "env": ["CI"]
    }
  }
}
