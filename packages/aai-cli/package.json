{
  "name": "@alexkroman1/aai-cli",
  "version": "9.0.1",
  "type": "module",
  "bin": {
    "aai": "bin.mjs"
  },
  "exports": {
    "./client-bundler": {
      "@dev/source": "./client-bundler.ts",
      "types": "./dist/client-bundler.d.ts",
      "import": "./dist/client-bundler.mjs"
    },
    "./worker-bundler": {
      "@dev/source": "./worker-bundler.ts",
      "types": "./dist/worker-bundler.d.ts",
      "import": "./dist/worker-bundler.mjs"
    },
    "./typecheck": {
      "@dev/source": "./typecheck.ts",
      "types": "./dist/typecheck.d.ts",
      "import": "./dist/typecheck.mjs"
    },
    "./project-config": {
      "@dev/source": "./project-config.ts",
      "types": "./dist/project-config.d.ts",
      "import": "./dist/project-config.mjs"
    }
  },
  "files": [
    "bin.mjs",
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown && tsc -p tsconfig.build.json && node ./bundle-templates.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check:publint": "publint",
    "check:attw": "attw --pack --profile esm-only",
    "test:scenario": "VITEST_PROFILE=scenario VITEST_SETUP=./_test-setup.ts VITEST_INCLUDE=**/*.scenario.test.ts vitest run -c ../../vitest.slow.config.ts",
    "check:scenario": "pnpm run test:scenario",
    "test:e2e": "VITEST_PROFILE=e2e VITEST_SETUP=./_test-setup.ts VITEST_INCLUDE=e2e*.test.ts vitest run -c ../../vitest.slow.config.ts",
    "check:e2e": "pnpm run test:e2e"
  },
  "dependencies": {
    "@alexkroman1/aai": "workspace:*",
    "@alexkroman1/aai-runtime": "workspace:*",
    "@alexkroman1/aai-ui": "workspace:*",
    "@clack/prompts": "^1.7.0",
    "@workflow/builders": "4.1.7",
    "chokidar": "^5.0.0",
    "citty": "^0.2.2",
    "env-paths": "^4.0.0",
    "execa": "^10.0.1",
    "get-port": "^7.2.0",
    "ofetch": "^1.5.1",
    "p-debounce": "^5.1.0",
    "p-timeout": "catalog:",
    "vite": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "aai-templates": "workspace:*",
    "playwright": "^1.62.1",
    "tsdown": "catalog:",
    "verdaccio": "^6.9.2",
    "vitest": "catalog:",
    "workflow": "4.8.2"
  },
  "peerDependencies": {
    "vitest": "^4.1.10"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexkroman/agent.git",
    "directory": "packages/aai-cli"
  }
}
