{
  "name": "@alexkroman1/aai-cli",
  "version": "5.9.0",
  "type": "module",
  "bin": {
    "aai": "bin.mjs"
  },
  "publishConfig": {
    "bin": {
      "aai": "dist/cli.mjs"
    }
  },
  "exports": {
    "./client-bundler": {
      "@dev/source": "./client-bundler.ts",
      "types": "./dist/client-bundler.d.ts",
      "import": "./dist/client-bundler.mjs"
    },
    "./worker-bundler": {
      "@dev/source": "./worker-bundler.ts",
      "types": "./dist/worker-bundler.d.ts",
      "import": "./dist/worker-bundler.mjs"
    },
    "./typecheck": {
      "@dev/source": "./typecheck.ts",
      "types": "./dist/typecheck.d.ts",
      "import": "./dist/typecheck.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown && tsc -p tsconfig.build.json && node ./bundle-templates.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check:publint": "publint",
    "check:attw": "attw --pack --profile esm-only",
    "test:e2e": "VITEST_PROFILE=e2e VITEST_INCLUDE=e2e*.test.ts vitest run -c ../../vitest.slow.config.ts",
    "check:e2e": "pnpm run test:e2e"
  },
  "dependencies": {
    "@alexkroman1/aai": "workspace:*",
    "@alexkroman1/aai-ui": "workspace:*",
    "@clack/prompts": "^1.7.0",
    "chokidar": "^5.0.0",
    "citty": "^0.2.2",
    "env-paths": "^4.0.0",
    "execa": "^10.0.0",
    "get-port": "^7.2.0",
    "ofetch": "^1.5.1",
    "p-debounce": "^5.1.0",
    "p-timeout": "^7.0.1",
    "vite": "^8.1.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "aai-templates": "workspace:*",
    "playwright": "^1.61.1",
    "tsdown": "^0.22.13",
    "verdaccio": "^6.8.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "vitest": "^4.1.10"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexkroman/agent.git",
    "directory": "packages/aai-cli"
  }
}
