// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`manifest schema shapes > AgentConfigSchema shape 1`] = `
[
  "builtinTools",
  "clientInbox",
  "description",
  "errorPhrase",
  "greeting",
  "idleTimeoutMs",
  "interruption",
