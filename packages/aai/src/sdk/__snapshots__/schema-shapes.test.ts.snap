  "tts",
  "turnTaking",
  "usageLimits",
  "voicePresets",
]
`;

exports[`manifest schema shapes > ToolSchemaSchema shape 1`] = `
[
  "description",
  "messages",
  "name",
  "parameters",
  "type",
]
`;

exports[`protocol schema shapes > ReadyConfigSchema shape 1`] = `
[
  "audioFormat",
  "sampleRate",
  "ttsSampleRate",
]
`;

