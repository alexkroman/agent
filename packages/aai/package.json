{
  "name": "@alexkroman1/aai",
  "version": "5.14.0",
  "type": "module",
  "exports": {
    ".": {
      "@dev/source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./utils": {
      "@dev/source": "./sdk/utils.ts",
      "types": "./dist/sdk/utils.d.ts",
      "import": "./dist/sdk/utils.js"
    },
    "./testing": {
      "@dev/source": "./sdk/testing.ts",
      "types": "./dist/sdk/testing.d.ts",
      "import": "./dist/sdk/testing.js"
    },
    "./workflow-api": {
      "@dev/source": "./sdk/workflow-api-client.ts",
      "types": "./dist/sdk/workflow-api-client.d.ts",
      "import": "./dist/sdk/workflow-api-client.js"
    },
    "./protocol": {
      "@dev/source": "./sdk/protocol.ts",
      "types": "./dist/sdk/protocol.d.ts",
      "import": "./dist/sdk/protocol.js"
    },
    "./runtime": {
      "@dev/source": "./host/runtime-barrel.ts",
      "types": "./dist/host/runtime-barrel.d.ts",
      "import": "./dist/host/runtime-barrel.js"
    },
    "./workspace-files": {
      "@dev/source": "./host/workspace-files.ts",
      "types": "./dist/host/workspace-files.d.ts",
      "import": "./dist/host/workspace-files.js"
    },
    "./slugify": {
      "@dev/source": "./host/slugify.ts",
      "types": "./dist/host/slugify.d.ts",
      "import": "./dist/host/slugify.js"
    },
    "./manifest": {
      "@dev/source": "./sdk/manifest-barrel.ts",
      "types": "./dist/sdk/manifest-barrel.d.ts",
      "import": "./dist/sdk/manifest-barrel.js"
    },
    "./stt": {
      "@dev/source": "./sdk/providers/stt-barrel.ts",
      "types": "./dist/sdk/providers/stt-barrel.d.ts",
      "import": "./dist/sdk/providers/stt-barrel.js"
    },
    "./tts": {
      "@dev/source": "./sdk/providers/tts-barrel.ts",
      "types": "./dist/sdk/providers/tts-barrel.d.ts",
      "import": "./dist/sdk/providers/tts-barrel.js"
    },
    "./llm": {
      "@dev/source": "./sdk/providers/llm-barrel.ts",
      "types": "./dist/sdk/providers/llm-barrel.d.ts",
      "import": "./dist/sdk/providers/llm-barrel.js"
    },
    "./s2s": {
      "@dev/source": "./sdk/providers/s2s-barrel.ts",
      "types": "./dist/sdk/providers/s2s-barrel.d.ts",
      "import": "./dist/sdk/providers/s2s-barrel.js"
    },
    "./tools": {
      "@dev/source": "./host/agent-tools.ts",
      "types": "./dist/host/agent-tools.d.ts",
      "import": "./dist/host/agent-tools.js"
    },
    "./internal": {
      "@dev/source": "./internal.ts",
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "VITEST_INCLUDE=host/integration/**/*.integration.test.ts vitest run -c ../../vitest.slow.config.ts",
    "check:integration": "pnpm run test:integration",
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p sdk/tsconfig.json",
    "lint": "biome check .",
    "check:publint": "publint",
    "check:attw": "attw --pack --profile esm-only"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/google": "^4.0.42",
    "@ai-sdk/groq": "^4.0.28",
    "@ai-sdk/mistral": "^4.0.29",
    "@ai-sdk/openai": "^4.0.40",
    "@ai-sdk/xai": "^4.0.36",
    "@cartesia/cartesia-js": "^3.5.1",
    "@deepgram/sdk": "^5.8.0",
    "@elevenlabs/elevenlabs-js": "^2.63.0",
    "@sindresorhus/slugify": "^3.0.0",
    "@workflow/world": "4.3.1",
    "@workflow/world-postgres": "4.3.3",
    "ai": "catalog:",
    "assemblyai": "^4.36.5",
    "bogon": "^1.3.0",
    "escape-html": "^1.0.3",
    "expr-eval-fork": "^3.0.3",
    "html-to-text": "^10.0.0",
    "htmlparser2": "^12.0.0",
    "jsonrepair": "^3.15.0",
    "mime-types": "catalog:",
    "nanoevents": "^10.0.0",
    "p-event": "^7.1.0",
    "p-timeout": "catalog:",
    "postgres": "^3.4.9",
    "undici": "^8.10.0",
    "workflow": "4.8.2",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/escape-html": "^1.0.4",
    "@types/html-to-text": "^9.0.4",
    "@types/json-schema": "catalog:",
    "@types/mime-types": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "fast-check": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexkroman/agent.git",
    "directory": "packages/aai"
  }
}
