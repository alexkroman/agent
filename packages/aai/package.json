      "@dev/source": "./src/sdk/providers/s2s-barrel.ts",
      "types": "./dist/sdk/providers/s2s-barrel.d.ts",
      "import": "./dist/sdk/providers/s2s-barrel.js"
    },
    "./ffmpeg": {
      "@dev/source": "./src/host/ffmpeg-barrel.ts",
      "types": "./dist/host/ffmpeg-barrel.d.ts",
      "import": "./dist/host/ffmpeg-barrel.js"
    },
    "./html": {
      "@dev/source": "./src/host/html-barrel.ts",
      "types": "./dist/host/html-barrel.d.ts",
      "import": "./dist/host/html-barrel.js"
    },
    "./step-files": {
      "@dev/source": "./src/host/step-files-barrel.ts",
      "types": "./dist/host/step-files-barrel.d.ts",
