{
  "name": "@alexkroman1/aai",
  "version": "15.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexkroman/agent.git",
    "directory": "packages/aai"
  },
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "AGENT_GUIDE.md",
    "skills"
  ],
  "exports": {
    ".": {
      "@dev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./utils": {
      "@dev/source": "./src/sdk/utils-barrel.ts",
      "types": "./dist/sdk/utils-barrel.d.ts",
      "import": "./dist/sdk/utils-barrel.js"
    },
    "./step": {
      "@dev/source": "./src/sdk/step-barrel.ts",
      "types": "./dist/sdk/step-barrel.d.ts",
      "import": "./dist/sdk/step-barrel.js"
    },
    "./testing": {
      "@dev/source": "./src/sdk/testing-barrel.ts",
      "types": "./dist/sdk/testing-barrel.d.ts",
      "import": "./dist/sdk/testing-barrel.js"
    },
    "./testing/vitest": {
      "@dev/source": "./src/sdk/testing-vitest-barrel.ts",
      "types": "./dist/sdk/testing-vitest-barrel.d.ts",
      "import": "./dist/sdk/testing-vitest-barrel.js"
    },
    "./testing/vite": {
      "@dev/source": "./src/host/testing-vite-barrel.ts",
      "types": "./dist/host/testing-vite-barrel.d.ts",
      "import": "./dist/host/testing-vite-barrel.js"
    },
    "./channels": {
      "@dev/source": "./src/sdk/channels-barrel.ts",
      "types": "./dist/sdk/channels-barrel.d.ts",
      "import": "./dist/sdk/channels-barrel.js"
    },
    "./step-errors": {
      "@dev/source": "./src/sdk/step-errors-barrel.ts",
      "types": "./dist/sdk/step-errors-barrel.d.ts",
      "import": "./dist/sdk/step-errors-barrel.js"
    },
    "./workflow-api": {
      "@dev/source": "./src/sdk/workflow-api-barrel.ts",
      "types": "./dist/sdk/workflow-api-barrel.d.ts",
      "import": "./dist/sdk/workflow-api-barrel.js"
    },
    "./protocol": {
      "@dev/source": "./src/sdk/protocol-barrel.ts",
