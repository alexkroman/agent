    "./internal": {
      "@dev/source": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./host-internal": {
      "@dev/source": "./src/host-internal.ts",
      "types": "./dist/host-internal.d.ts",
      "import": "./dist/host-internal.js"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "check:attw": "attw --pack --profile esm-only",
    "check:publint": "publint",
    "check:scenario": "pnpm run test:scenario",
    "lint": "biome check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:scenario": "VITEST_PROFILE=scenario VITEST_INCLUDE=src/host/**/*.scenario.test.ts vitest run -c ../../vitest.slow.config.ts",
    "typecheck": "tsc --noEmit && tsc -p src/sdk/tsconfig.json"
  },
  "dependencies": {
    "@sindresorhus/slugify": "^3.0.1",
    "bogon": "^1.3.0",
    "eventsource-parser": "catalog:",
    "expr-eval-fork": "^3.0.3",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^12.0.0",
    "p-timeout": "catalog:",
    "undici": "^8.10.1",
    "xstate": "catalog:"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/json-schema": "catalog:",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "vitest": ">=3",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
