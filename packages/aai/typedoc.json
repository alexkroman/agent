{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "dist/index.d.ts",
    "dist/sdk/utils.d.ts",
    "dist/sdk/step-barrel.d.ts",
    "dist/sdk/testing.d.ts",
    "dist/sdk/testing-vitest.d.ts",
    "dist/sdk/step-errors.d.ts",
    "dist/sdk/workflow-api-barrel.d.ts",
    "dist/sdk/protocol.d.ts",
    "dist/host/runtime-barrel.d.ts",
    "dist/sdk/manifest-barrel.d.ts",
    "dist/sdk/providers/stt-barrel.d.ts",
    "dist/sdk/providers/tts-barrel.d.ts",
    "dist/sdk/providers/llm-barrel.d.ts",
    "dist/sdk/providers/s2s-barrel.d.ts",
    "dist/host/agent-tools.d.ts",
    "dist/host/ffmpeg.d.ts"
  ],
  "externalSymbolLinkMappings": {
    "ai": {
      "LanguageModel": "https://ai-sdk.dev/docs/reference/ai-sdk-core/language-model"
    }
  },
  "intentionallyNotExported": [
    "StandardSchemaV1",
    // The ten field-list and message types behind `AgentParams`' four arms, plus
    // the endpointing one. They are the implementation of a compile error — an
    // author reads them in the message tsc prints, never by name — so they are
    // off the root barrel and out of the docs, while still appearing inline in
    // the arms' rendered signatures. See the re-export comment at the foot of
    // `sdk/define.ts`.
    "DefaultedAgentField",
    "EndpointingOnDescriptorMisuse",
    "FrontDoorField",
    "InlineToolsField",
    "InlineToolsMisuse",
    "PipelineOnlyField",
    "PipelineOnlyMisuse",
    "ProviderField",
    "StaticFrontDoorMisuse",
    "WorkflowAppMisuse",
    "WorkflowAppOnlyField",
    // A type-level helper, not API: `SessionEventBody` is
    // `DistributiveOmit<SessionEvent, "meta">` because a plain `Omit` over a
    // discriminated union collapses it to one non-discriminated object. Nothing a
    // consumer can name, and nothing they need to — the distribution is what they
    // get. Exporting it to satisfy the reference would put a conditional-type
    // utility on the published surface.
    "DistributiveOmit",
    // A module-private type-level helper in `host/transports/types.ts`: it makes a
    // typo'd event name a compile error by constraining `TransportEventBody`'s key
    // to the event union. Inlining it would delete that check and duplicate the
    // name list. Same case as `DistributiveOmit` above — nothing a consumer names.
    "EventsNamed"
  ]
}
