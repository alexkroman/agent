{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "dist/index.d.ts",
    "dist/sdk/utils-barrel.d.ts",
    "dist/sdk/step-barrel.d.ts",
    "dist/sdk/testing-barrel.d.ts",
    "dist/sdk/testing-vitest-barrel.d.ts",
    "dist/sdk/step-errors-barrel.d.ts",
    "dist/sdk/channels-barrel.d.ts",
    "dist/sdk/workflow-api-barrel.d.ts",
    "dist/sdk/protocol-barrel.d.ts",
    "dist/sdk/manifest-barrel.d.ts",
    "dist/sdk/providers/stt-barrel.d.ts",
    "dist/sdk/providers/tts-barrel.d.ts",
    "dist/sdk/providers/llm-barrel.d.ts",
    "dist/sdk/providers/s2s-barrel.d.ts",
    "dist/host/tools-barrel.d.ts",
    "dist/host/coding-tools-barrel.d.ts",
    "dist/host/ffmpeg-barrel.d.ts",
    "dist/host/html-barrel.d.ts",
    "dist/host/step-files-barrel.d.ts"
  ],
  "externalSymbolLinkMappings": {
    "ai": {
      "LanguageModel": "https://ai-sdk.dev/docs/reference/ai-sdk-core/language-model"
    }
  },
  "intentionallyNotExported": [
    // The step-name literal guard, the same shape as everything else in this
    // list: `Literal<Name>` is the IMPLEMENTATION of a compile error — an
    // author meets it as the message tsc prints when a step name has widened
    // to `string`, never by name — so it stays off the root barrel and out of
    // the docs while still rendering inline in `step`'s signature, which is
    // where a reader needs it. Exporting it instead would put a pure
    // type-level constraint on the published surface AND, with the contract
    // coverage deny-list now empty, oblige a frozen example naming it.
    "Literal",
    // The two mutation-window guards. Same shape as the `AgentParams` misuse
    // types below: they are the IMPLEMENTATION of a compile error — an author
    // meets `RejectThenable` as the message tsc prints when a slot mutation
    // body is `async`, never by name — so they stay off the root barrel and out
    // of the docs while still rendering inline in `update`'s and `after`'s
    // signatures, where they are what a reader needs to see.
    "RejectThenable",
    "RejectThenableResult",
    // `StandardSchemaV1` and `StandardSchemaIssue` used to be listed here. They
    // are exported from the root now, owned by the `standard-schema` capability,
    // because eight contracts hashed their bodies while none owned them.
    // The field-list and message types behind `AgentParams`' four arms, plus
    // the endpointing pair and the silence-nudge one. They are the implementation of a compile error — an
    // author reads them in the message tsc prints, never by name — so they are
    // off the root barrel and out of the docs, while still appearing inline in
    // the arms' rendered signatures. See the re-export comment at the foot of
    // `sdk/define.ts`.
    //
    // `StaticAgentParamsCore` is one of the arms rather than a field list, and
    // it is here for the same reason: it exists so the twenty misuse MESSAGES
    // stay off the union tsc prints at every `agent()` call site, and the shape
    // it names is documented as `StaticAgentParams` — which a reader does click,
    // and which `Omit`s this one rather than sharing a third base.
    "DefaultedAgentField",
    "EndpointingOnDescriptorMisuse",
    "FrontDoorField",
    "InlineToolsField",
    "InlineToolsMisuse",
    "PipelineOnlyField",
    "PipelineOnlyMisuse",
    "ProviderField",
    "SilenceNudgeField",
    "SilenceNudgeParams",
    "StaticAgentParamsCore",
    "StaticFrontDoorMisuse",
    "WorkflowAppMisuse",
    "WorkflowAppOnlyField"
    // `DistributiveOmit`, `EventOf` and `NamesInMap` used to be listed here.
    // `SessionEventBody` is a lookup into the exported `SessionEventMap` now, and
    // `DialogEvent<S>` is written over the exported `DialogEventNames<M>`, so
    // there is no unexported helper left in either signature to excuse.
  ]
}
