{
  "name": "aai-studio-server",
  "version": "0.6.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "@dev/source": "./index.ts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "predev": "node -e \"const [maj] = process.versions.node.split('.').map(Number); if (maj < 26) { console.error('Node >=26 required (got ' + process.version + '). Run: fnm use 26'); process.exit(1); }\" && node ../../scripts/ensure-guest-harness.mjs && pnpm --filter aai-studio-client build",
    "dev": "node --conditions=@dev/source index.ts",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@alexkroman1/aai": "workspace:*",
    "@alexkroman1/aai-ui": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "aai-server": "workspace:*",
    "aai-studio-client": "workspace:*",
    "hono": "^4.12.31",
    "mime-types": "^3.0.2",
    "p-timeout": "^7.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "aai-templates": "workspace:*",
    "fast-check": "^4.9.0",
    "tsdown": "^0.22.13",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
