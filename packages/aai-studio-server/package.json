{
  "name": "aai-studio-server",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": {
      "@dev/source": "./index.ts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "predev": "node -e \"const [maj] = process.versions.node.split('.').map(Number); if (maj < 26) { console.error('Node >=26 required (got ' + process.version + '). Run: fnm use 26'); process.exit(1); }\" && node ../../scripts/ensure-guest-harness.mjs && pnpm --filter aai-studio-client build",
    "dev": "node ../../scripts/dev-server.mjs node --conditions=@dev/source index.ts",
    "start": "node dist/index.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:scenario": "VITEST_PROFILE=scenario VITEST_INCLUDE=**/*.scenario.test.ts vitest run -c ../../vitest.slow.config.ts",
    "check:scenario": "pnpm run test:scenario",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "dependencies": {
    "@alexkroman1/aai": "workspace:*",
    "@alexkroman1/aai-ui": "workspace:*",
    "@hono/zod-validator": "catalog:",
    "aai-server": "workspace:*",
    "aai-studio-client": "workspace:*",
    "hono": "catalog:",
    "mime-types": "catalog:",
    "p-timeout": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/mime-types": "catalog:",
    "aai-templates": "workspace:*",
    "fast-check": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
