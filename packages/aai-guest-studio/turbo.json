{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // `project-shape.test.ts` is a DRIFT GATE over files in another package: it
    // reads `aai-templates/scaffold/package.json` and `scaffold/tsconfig.json`
    // to hold `WORKSPACE_DEPENDENCIES` and `workspaceTsconfig()` against the
    // scaffold a laptop project is built from. Neither file is named by any
    // input glob this package owns.
    //
    // It is NOT currently being served from cache, and the reason is worth
    // recording because it is not a property of this gate: this package depends
    // on `@alexkroman1/aai-cli`, which depends on `aai-templates`, so a scaffold
    // change reaches this task's hash through `^build`. That is INCIDENTAL — the
    // edge exists because the CLI bundles the templates as shipped product, not
    // because this gate reads the scaffold, and it evaporates the moment either
    // coupling changes. Naming the two files makes the gate's real inputs its
    // own, which is what the same rule in `packages/aai-templates/turbo.json`
    // says.
    //
    // `inputs` globs resolve relative to the PACKAGE, so a repo-root file needs
    // the `$TURBO_ROOT$` prefix. A task named here REPLACES the root's
    // definition rather than merging with it, so `env` and `outputs` are
    // restated verbatim — dropping either is silent.
    //
    // No own `build`: this package has no build script. The harness artifact
    // assertion that needs one is `aai-guest`'s.
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "../../vitest.shared.ts",
        "$TURBO_ROOT$/packages/aai-templates/scaffold/package.json",
        "$TURBO_ROOT$/packages/aai-templates/scaffold/tsconfig.json"
      ],
      "env": ["CI", "VITEST_POOL"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "../../vitest.shared.ts",
        "$TURBO_ROOT$/packages/aai-templates/scaffold/package.json",
        "$TURBO_ROOT$/packages/aai-templates/scaffold/tsconfig.json"
      ],
      "outputs": ["coverage/**"],
      "env": ["CI", "VITEST_POOL"]
    }
  }
}
