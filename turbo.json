{
  "$schema": "https://turbo.build/schema.json",
  "cacheDir": ".turbo/cache",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    // The config BOTH slow tiers actually run under (`vitest run -c
    // ../../vitest.slow.config.ts`). `check:integration` used to name a
    // `vitest.integration.config.ts` that has never existed, so editing the
    // real one changed nothing and turbo replayed the previous run. Same class
    // of miss as the root tsconfig above: a root file a task depends on has to
    // be hashed, and `inputs` globs resolve relative to the PACKAGE.
    "vitest.slow.config.ts",
    // The platform schema, read by six suites — including
    // `platform-schema.test.ts`, which is in the UNIT tier and whose whole job
    // is to assert every `aai_platform.<table>` the source queries is declared
    // by a migration. Third instance of the rule two entries up: a repo-root
    // directory is covered by no package's `inputs`, so editing a migration
    // could not invalidate the cache of the test that guards migrations, in
    // either tier. Verified the documented way — capture `turbo run test
    // --filter aai-server --dry=json`'s hash, touch a migration, capture
    // again; before this entry `aai-server#test` was byte-identical.
    "supabase/migrations/**",
    // `aai-server`'s vitest `globalSetup` (`vitest.config.ts` names it by
    // repo-relative path), plus `aai-studio-server`'s `predev` and
    // `aai-server`'s `predeploy:modal`. Fourth instance of the rule above and
    // the same fix: `inputs` globs resolve relative to the PACKAGE, so a
    // repo-root file a task depends on belongs here. Verified the documented
    // way — capture `turbo run test --filter ./packages/aai-server --dry=json`'s
    // hash, touch this script, capture again; before this entry the hash was
    // byte-identical, so a change to the harness verify logic replayed a cached
    // green run.
    "scripts/ensure-guest-harness.mjs"
  ],
  "globalPassThroughEnv": [
    // Ambient machine config, same class as the proxy/CA vars below. Stripped
    // by strict env mode, `os.tmpdir()` falls back to `/tmp` — shared, not
    // per-user, and not cleaned between runs, so anything a task writes there
    // collides with every other user and with its own previous runs. It also
    // changes behaviour: `npm prefix` walks up for the nearest `package.json`
    // or `node_modules`, and a stray `/tmp/node_modules` (easy to acquire from
    // one `npm install` in the wrong shell) makes it report `/tmp` instead of
    // the directory npm was given.
    "TMPDIR",
    "TMP",
    "TEMP",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "no_proxy",
    "npm_config_proxy",
    "npm_config_https_proxy",
    "npm_config_noproxy",
    "NODE_EXTRA_CA_CERTS",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR",
    "ASSEMBLYAI_API_KEY",
    "ANTHROPIC_API_KEY",
    "GUEST_HARNESS_PATH",
    "TURBO_HASH",
    // Ambient CI marker, not a behaviour switch: the fs gates (`check:invariants`,
    // `check:konsistent`) read it only to decide whether to also emit
    // `::error file=…` annotations so violations land inline on the PR diff.
    // The pass/fail is identical either way, which is exactly why this belongs
    // here and not in a task's `env` — putting it there would fragment every
    // task's cache between local and CI runs for a formatting difference.
    "GITHUB_ACTIONS"
  ],
  "tasks": {
    // `$TURBO_DEFAULT$` — every git-tracked file in the package — rather than a
    // hand-kept list of extensions. The list missed the Vite inputs of the two
    // packages that have them: `aai-ui#build` did not hash `index.html`,
    // `styles.css` or `public/**`, and `aai-studio-client#build` missed those
    // plus `src/assets/*.svg` and `src/fonts/*.woff2` — so a Tailwind- or
    // HTML-only change was a FULL TURBO replay of the previous bundle, and CI's
    // setup job handed that stale dist to every downstream job. An extension
    // list can only ever be right about the file types that exist today.
    //
    // Markdown is excluded because no build reads it and CHANGELOG.md is
    // rewritten by every changesets release. `aai-cli` deliberately does NOT
    // inherit that exclusion — it bundles the templates and the scaffold, whose
    // markdown (scaffold/CLAUDE.md above all) is shipped product.
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.test-d.ts",
        "!**/*.md"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    // Tests read more than TypeScript: JSON fixtures (`aai/host/fixtures/`,
    // `aai-ui/fixtures/`, `aai/sdk/compat-fixtures/`) and snapshots
    // (`__snapshots__/*.snap`) were all unhashed, so an edited fixture — or an
    // obsolete snapshot, which `update: "none"` exists to turn into a FAILURE —
    // replayed green. `$TURBO_DEFAULT$` covers whatever a fixture is next
    // written in. Markdown is excluded here as it is for build; the one suite
    // that really does read markdown (aai-templates) re-includes it, along with
    // the other repo-root files it reads, in its own turbo.json.
    //
    // VITEST_POOL is DECLARED, not passed through: turbo runs in strict env
    // mode, so an undeclared variable never reaches the task at all. Declaring
    // it in `env` also puts it in the hash, so a forks run and a threads run
    // cannot share a cache entry.
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "../../vitest.shared.ts"
      ],
      "env": [
        "CI",
        "VITEST_POOL"
      ]
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "../../vitest.shared.ts"
      ],
      "outputs": [
        "coverage/**"
      ],
      "env": [
        "CI",
        "VITEST_POOL"
      ]
    },
    // `dependsOn: ["build"]` is SCHEDULING, not a requirement: every package
    // type-checks with no `dist` present anywhere, because `@dev/source`
    // resolves cross-package imports to TypeScript source. It is kept because
    // dropping it is slower, not faster — tsc and tsdown then run concurrently
    // and fight for cores (measured on 4 cores: `turbo run build typecheck
    // --force`, 21.2s with the dependency, 25.7s without).
    "typecheck": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "tsconfig*.json"
      ]
    },
    // `biome check .` lints JSON and CSS as well as TS/TSX — a formatting error
    // injected into `packages/aai/typedoc.json` is reported by biome but left
    // the lint hash untouched while this listed only `**/*.ts`/`**/*.tsx`.
    // `$TURBO_DEFAULT$` keeps this correct as biome grows languages.
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../biome.json"
      ]
    },
    "check:publint": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "dist/**",
        "package.json"
      ]
    },
    "check:attw": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "dist/**",
        "package.json"
      ]
    },
    // The integration tier is now in-memory ONLY — multiple modules, no
    // filesystem, no subprocess, no port, no database (see the profile docs in
    // `vitest.slow.config.ts`). Everything that needs a real resource is
    // `check:scenario` below, which is where the env declarations moved with it.
    //
    // VITEST_PROFILE/VITEST_INCLUDE are declared even though each package's script
    // sets them inline: a variable that selects what a task DOES belongs in the
    // hash, so an override from the command line cannot share a cache entry with
    // the default run. That is the rule `AAI_TEST_PM` and `VITEST_POOL` are in
    // `env` for.
    "check:integration": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "VITEST_PROFILE",
        "VITEST_INCLUDE",
        "VITEST_POOL",
        // `pipeline-reference.integration.test.ts` SKIPS without a reference
        // stack and this turns that skip into a hard failure. Same shape and
        // same reason as `AAI_REQUIRE_PG` / `AAI_REQUIRE_STACK` on
        // `check:scenario` below: strict env mode strips an undeclared variable
        // before the task starts, so the enforcement would be silently inert —
        // which is the exact failure it exists to prevent. In `env` rather than
        // `globalPassThroughEnv` because it selects what the task DOES: a
        // required run and a skippable one must not share a cache entry.
        "AAI_REQUIRE_REFERENCE_STACK"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "../../vitest.shared.ts"
      ]
    },
    // A real subprocess, a real HTTP/WebSocket port, a real bundler, or a real
    // Postgres. Split out of `check:integration` because one config could not
    // serve both populations: `pipeline-fuzz` (pure memory) and
    // `platform-schema` (needs a database) shared one timeout, one retry policy
    // and one queue, and neither was configured for its own failure mode.
    //
    // AAI_REQUIRE_PG rides beside the URL for the reason the AAI_TEST_PM note
    // below spells out: strict env mode strips an undeclared variable before
    // the task starts, so CI's "a skip is a failure" enforcement would be
    // silently inert — the failure mode it exists to prevent, one level up.
    // In `env` rather than `globalPassThroughEnv` because it changes what the
    // task DOES: a required run and a skippable one must not share a cache
    // entry.
    "check:scenario": {
      "dependsOn": [
        "build"
      ],
      "env": [
        "AAI_TEST_PG_URL",
        "AAI_REQUIRE_PG",
        // The whole local Supabase stack, resolved by `with-test-pg.mjs` out of
        // `supabase status -o env`. Declared for both of AAI_REQUIRE_PG's
        // reasons and they bite harder here: these are the ONLY arm the platform
        // stores have (a stock Postgres runs none of Vault, pg_cron or walrus),
        // so a stripped variable is not a narrower run, it is the platform tier
        // silently absent. In `env`, so a stack run and a database-only run
        // cannot share a cache entry.
        "AAI_TEST_SUPABASE_URL",
        "AAI_TEST_SUPABASE_SERVICE_KEY",
        "AAI_TEST_SUPABASE_ANON_KEY",
        "AAI_REQUIRE_STACK",
        // ffmpeg for `aai/host/ffmpeg.scenario.test.ts`, the only thing that
        // checks the ARGV those helpers build against a real binary. Declared
        // for the same reason as the two above: strict env mode strips an
        // undeclared variable, so "a skip here is a failure" would be inert —
        // and this suite skips SILENTLY useful only if nobody relies on it.
        "AAI_REQUIRE_FFMPEG",
        "AAI_FAULT_PROFILE",
        "VITEST_PROFILE",
        "VITEST_INCLUDE",
        "VITEST_POOL"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "../../vitest.shared.ts"
      ]
    },
    // AAI_TEST_PM is the documented way to reproduce a user report under npm or
    // yarn (`AAI_TEST_PM=npm pnpm test:e2e`). `pnpm test:e2e` IS `turbo run
    // check:e2e`, and under strict env mode an undeclared variable is stripped
    // before the task starts — so that command silently ran pnpm. Declaring it
    // here both passes it through and makes each package manager its own cache
    // entry.
    //
    // AAI_FAULT_PROFILE is here for both halves of that same reason
    // (`AAI_FAULT_PROFILE=restart-on-boot pnpm test:e2e` would otherwise run
    // with no faults and say nothing), and the cache half matters more than
    // usual: a fault run and a clean run of the same tree MUST NOT share a cache
    // entry, or the first green clean run would serve a FULL TURBO for every
    // later fault run and the mode would test nothing.
    //
    // AAI_REQUIRE_REGISTRY is the third instance of the same pair of reasons, and
    // it is the one where a silent strip would be worst: it turns the suite's
    // "excuse a failed install as a registry-proxy flake" predicate OFF, so
    // undeclared it would leave CI's enforcement inert — a gate reporting success
    // while checking nothing, which is exactly what it exists to prevent. In
    // `env`, so a required run and a skippable one are different cache entries.
    // VITEST_POOL is the fourth instance, and it was MISSING while the three
    // above were declared — `VITEST_POOL=forks pnpm test:e2e` was stripped
    // silently, the same class the paragraph above documents. The other four
    // test tasks all declare it.
    //
    // `../../vitest.shared.ts` likewise: the e2e run reaches `sharedConfig`
    // through `vitest.slow.config.ts`, and the other four test tasks all hash
    // it. Verified the documented way — capture
    // `turbo run check:e2e --filter ./packages/aai-cli --dry=json`'s hash, touch
    // `vitest.shared.ts`, capture again; before this entry it was
    // byte-identical at `261096f60c7229f6`.
    "check:e2e": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "../../vitest.shared.ts"
      ],
      "env": [
        "AAI_TEST_PM",
        "AAI_FAULT_PROFILE",
        "AAI_REQUIRE_REGISTRY",
        "AAI_REQUIRE_BROWSER",
        "VITEST_POOL"
      ]
    },
    // The behaviour eval tier: a live model, a live key, real tokens. NOT in
    // `pnpm check` and not in CI — see `packages/aai-evals/CLAUDE.md` for why a
    // measurably noisy instrument must not be a merge gate.
    //
    // Every variable here SELECTS WHAT THE TASK DOES, which is the rule that
    // puts it in `env` rather than `globalPassThroughEnv`: strict env mode
    // strips an undeclared one silently, which is the failure that made
    // `AAI_TEST_PM=npm pnpm test:e2e` run pnpm and say nothing. `AAI_ORIGIN` and
    // `AAI_STEP_CAP_HINT` used to sit in `globalPassThroughEnv` for want of a
    // task to own them; the first is `AAI_EVAL_ORIGIN` now, since it names this
    // tier's target rather than ambient machine config.
    //
    // **`cache: false`, which is the one place this repo's `inputs` rule does
    // not apply.** Everywhere else a task is a pure function of its inputs and
    // the fix for a replayed green run is to hash more; here two runs of the
    // SAME tree legitimately differ — that is the documented property the tier
    // exists to report (0.56 against 0.60 on identical code, 9 of 25 tasks
    // flipping). A cache hit would therefore replay a measurement rather than
    // take one, so the second `pnpm test:eval` of a variance check would print
    // FULL TURBO and the number from the first. There is consequently no input
    // set to get right, and none is declared rather than declaring one that
    // nothing reads. If this ever becomes cacheable, note the corpus lives
    // OUTSIDE the package (`scripts/starter-eval/**`), where a package-relative
    // `$TURBO_DEFAULT$` cannot see it — the same miss the root `tsconfig.json`
    // sat in.
    "check:eval": {
      "cache": false,
      "dependsOn": [
        "build"
      ],
      "env": [
        "AAI_REQUIRE_EVAL",
        "AAI_EVAL_ORIGIN",
        "AAI_EVAL_REPEAT",
        "AAI_EVAL_ONLY",
        "AAI_EVAL_MIN_SCORE",
        "AAI_STEP_CAP_HINT",
        "VITEST_PROFILE",
        "VITEST_INCLUDE",
        "VITEST_POOL"
      ]
    },
    "//#check:syncpack": {
      "inputs": [
        "package.json",
        "packages/*/package.json",
        ".syncpackrc.json"
      ]
    },
    "//#check:sherif": {
      "inputs": [
        "package.json",
        "packages/*/package.json",
        "pnpm-workspace.yaml"
      ]
    },
    "//#check:knip": {
      "inputs": [
        "packages/**/*.ts",
        "packages/**/*.tsx",
        "knip.json",
        "package.json",
        "packages/*/package.json"
      ]
    },
    "//#check:markdown": {
      "inputs": [
        "**/*.md"
      ]
    },
    "//#lint:scripts": {
      "inputs": [
        "scripts/**",
        "biome.json"
      ]
    },
    "docs": {
      "dependsOn": [
        "@alexkroman1/aai#build",
        "@alexkroman1/aai-ui#build"
      ],
      "inputs": [
        "typedoc.json",
        "home.md",
        "tsconfig.typedoc.json",
        "$TURBO_ROOT$/packages/aai/typedoc.json",
        "$TURBO_ROOT$/packages/aai-ui/typedoc.json"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
