{
  "$schema": "https://turbo.build/schema.json",
  "cacheDir": "node_modules/.cache/turbo",
  "globalDependencies": [
    "pnpm-lock.yaml"
  ],
  "globalPassThroughEnv": [
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "no_proxy",
    "npm_config_proxy",
    "npm_config_https_proxy",
    "npm_config_noproxy",
    "NODE_EXTRA_CA_CERTS",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.test-d.ts",
        "tsconfig*.json",
        "tsdown.config.ts",
        "package.json"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "vitest.config.ts",
        "../../vitest.shared.ts"
      ],
      "env": [
        "CI"
      ]
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "vitest.config.ts",
        "../../vitest.shared.ts"
      ],
      "outputs": [
        "coverage/**"
      ],
      "env": [
        "CI"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "tsconfig*.json"
      ]
    },
    "lint": {
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "../../biome.json"
      ]
    },
    "check:publint": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "dist/**",
        "package.json"
      ]
    },
    "check:attw": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "dist/**",
        "package.json"
      ]
    },
    "check:integration": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "**/*.ts",
        "vitest.integration.config.ts",
        "../../vitest.shared.ts"
      ]
    },
    "check:e2e": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "**/*.ts",
        "**/*.tsx"
      ]
    },
    "check:typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "//#check:syncpack": {
      "inputs": [
        "package.json",
        "packages/*/package.json",
        ".syncpackrc.json"
      ]
    },
    "//#check:sherif": {
      "inputs": [
        "package.json",
        "packages/*/package.json",
        "pnpm-workspace.yaml"
      ]
    },
    "//#check:knip": {
      "inputs": [
        "packages/**/*.ts",
        "packages/**/*.tsx",
        "knip.json",
        "package.json",
        "packages/*/package.json"
      ]
    },
    "//#check:markdown": {
      "inputs": [
        "**/*.md"
      ]
    },
    "docs": {
      "dependsOn": [
        "@alexkroman1/aai#build",
        "@alexkroman1/aai-ui#build"
      ],
      "inputs": [
        "typedoc.json",
        "tsconfig.typedoc.json",
        "$TURBO_ROOT$/packages/aai/typedoc.json",
        "$TURBO_ROOT$/packages/aai-ui/typedoc.json"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
